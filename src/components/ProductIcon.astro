---
import type { ProductIconName } from "@/lib/product-catalog";

type Props = { name: ProductIconName; size?: "small" | "medium" | "large" };
const { name, size = "medium" } = Astro.props;
---
<span class:list={["product-icon", `product-icon-${size}`, `product-icon-${name}`]} aria-hidden="true">
  {name === "online_course" && <svg viewBox="0 0 24 24"><rect x="3" y="5" width="13" height="14" rx="2"/><path d="m16 10 5-3v10l-5-3M7 9h5M7 13h3"/></svg>}
  {name === "in_person_course" && <svg viewBox="0 0 24 24"><path d="M4 20V8l8-5 8 5v12M8 20v-7h8v7M3 20h18"/><circle cx="12" cy="8" r="1.5"/></svg>}
  {name === "video_course" && <svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="m10 9 5 3-5 3Z"/></svg>}
  {name === "audio_book" && <svg viewBox="0 0 24 24"><path d="M5 5.5A3.5 3.5 0 0 1 8.5 2H11v17H8.5A3.5 3.5 0 0 0 5 22Z"/><path d="M19 5.5A3.5 3.5 0 0 0 15.5 2H13v17h2.5a3.5 3.5 0 0 1 3.5 3Z"/><path d="M8 8v5M16 8v5"/></svg>}
  {name === "ebook" && <svg viewBox="0 0 24 24"><path d="M4 4h6a2 2 0 0 1 2 2v14a3 3 0 0 0-3-3H4ZM20 4h-6a2 2 0 0 0-2 2v14a3 3 0 0 1 3-3h5Z"/></svg>}
  {name === "quiz" && <svg viewBox="0 0 24 24"><path d="M6 3h12v18H6Z"/><path d="m9 9 1.5 1.5L14 7M9 15h6"/></svg>}
  {name === "test" && <svg viewBox="0 0 24 24"><path d="M7 3h10v4H7ZM5 5h2M17 5h2v16H5V5"/><path d="M8 11h8M8 15h8"/></svg>}
  {name === "mock_exam" && <svg viewBox="0 0 24 24"><circle cx="12" cy="13" r="8"/><path d="M12 9v4l3 2M9 2h6M12 2v3"/></svg>}
  {name === "reading" && <svg viewBox="0 0 24 24"><path d="M6 3h9l3 3v15H6Z"/><path d="M15 3v4h4M9 11h6M9 15h6"/></svg>}
  {name === "course" && <svg viewBox="0 0 24 24"><path d="m3 7 9-4 9 4-9 4Z"/><path d="M6 9.5V15l6 3 6-3V9.5M21 7v7"/></svg>}
</span>
