---
import OfferCard from "@/components/OfferCard.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { listPublishedOffers } from "@/lib/api-client";
import { localeFromCookies, translator } from "@/lib/i18n";

const locale = localeFromCookies(Astro.cookies);
const t = translator(locale);
const offers = await listPublishedOffers();
const searchQuery = Astro.url.searchParams.get("q")?.trim() ?? "";
const normalizedQuery = searchQuery.toLocaleLowerCase();
const matchingOffers = normalizedQuery
  ? offers.filter((offer) => [
      offer.title, offer.description, offer.creatorName, offer.deliveryMode, ...offer.formats, ...offer.topics, ...offer.includedTitles
    ].join(" ").toLocaleLowerCase().includes(normalizedQuery))
  : offers;
const featuredOffers = matchingOffers.slice(0, 6);
const learningSteps = [
  { number: "01", title: "Discover", copy: "Explore courses and see the formats, activities and resources included before you book." },
  { number: "02", title: "Book", copy: "Choose the offering, schedule and delivery format that fit your life." },
  { number: "03", title: "Learn", copy: "Watch lessons, join an online class or attend a session in person." },
  { number: "04", title: "Practise", copy: "Build understanding with quizzes, tests, mock exams, flashcards and activities." },
  { number: "05", title: "Progress", copy: "Keep sight of completed lessons, results, upcoming sessions and what comes next." }
];
const capabilities = [
  { mark: "●", title: "Live online classes", copy: "Learn directly with a creator or cohort from wherever you are." },
  { mark: "◆", title: "In-person experiences", copy: "Book workshops, tuition, seminars and practical sessions." },
  { mark: "▶", title: "Recorded lessons", copy: "Learn at your own pace and revisit important ideas." },
  { mark: "✓", title: "Quizzes and tests", copy: "Check understanding throughout the learning journey." },
  { mark: "M", title: "Mock exams", copy: "Practise under realistic assessment conditions." },
  { mark: "▤", title: "Ebooks and resources", copy: "Keep essential reading and materials in one place." },
  { mark: "▣", title: "Flashcards", copy: "Review important ideas and build long-term recall." },
  { mark: "↗", title: "Progress tracking", copy: "Know what you have completed and where to focus next." }
];
---

<BaseLayout
  title="PencilScope — Knowledge Shared by Experts"
  description="Learn from curated content created by experts who turn real-world experience into practical knowledge for everyone."
>
  <section class="course-first-section">
    <div class="shell">
      <div class="course-first-heading">
        <div><span class="eyebrow">{t("exploreLearning")}</span><h2>{t("findLearning")}</h2></div>
        <form class="course-search" action="/" method="get" role="search">
          <label class="sr-only" for="landing-course-search">{t("searchLearning")}</label>
          <input id="landing-course-search" name="q" type="search" value={searchQuery} placeholder={t("searchPlaceholder")} />
          <button class="button" type="submit">{t("search")}</button>
        </form>
      </div>
      <div class="course-search-meta"><span>{matchingOffers.length} {t(matchingOffers.length === 1 ? "result" : "results")}</span>{searchQuery && <a class="text-link" href="/">{t("clearSearch")}</a>}<a class="text-link" href="/offers">{t("exploreAll")}</a></div>
      {featuredOffers.length
        ? <div class="offer-grid">{featuredOffers.map((offer) => <OfferCard offer={offer} />)}</div>
        : <div class="panel course-search-empty"><h2>{t("noMatches")}</h2><p>{t("tryBroader")}</p><a class="button button-secondary" href="/">{t("showAll")}</a></div>}
    </div>
  </section>

  <section class="hero landing-hero">
    <div class="shell hero-grid">
      <div class="hero-copy">
        <span class="eyebrow">{t("heroEyebrow")}</span>
        <h1>{t("heroTitle")}</h1>
        <p>{t("heroCopy")}</p>
        <div class="hero-actions">
          <a class="button" href="/offers">{t("exploreLearning")}</a>
          <a class="button button-ghost" href="/register?next=/offers"><span class="play">＋</span> {t("signUpFree")}</a>
        </div>
        <div class="hero-reassurance"><span>{t("browseBefore")}</span><i></i><span>{t("freeAccount")}</span><i></i><span>{t("progressTogether")}</span></div>
      </div>
      <div class="journey-art" aria-label="A learning journey from choosing a course to making progress">
        <div class="journey-card journey-card-main"><span>01</span><strong>Choose what you need</strong><small>A focused product or a full course</small></div>
        <div class="journey-path" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
        <div class="journey-mini-grid">
          <div class="journey-card"><span>02</span><strong>Book</strong></div>
          <div class="journey-card"><span>03</span><strong>Learn</strong></div>
          <div class="journey-card"><span>04</span><strong>Practise</strong></div>
          <div class="journey-card"><span>05</span><strong>Progress</strong></div>
        </div>
        <div class="hero-feature-cloud" aria-label="Available learning formats"><span>Live online</span><span>In person</span><span>Video</span><span>Quiz</span><span>Ebook</span></div>
      </div>
    </div>
    <div class="subject-ribbon" aria-label="PencilScope learning benefits"><span>Find the right fit</span><i></i><span>Learn your way</span><i></i><span>Practise with purpose</span><i></i><span>Track real progress</span></div>
  </section>

  <section class="section shell landing-intro">
    <div class="landing-section-heading"><div><span class="eyebrow">More than watching a course</span><h2>Everything you need to keep moving forward.</h2></div><p>PencilScope brings lessons, classes, assessments, resources, progress and trusted support into one thoughtful learning experience.</p></div>
    <div class="value-grid">
      <article><span>01</span><h3>Learn your way</h3><p>Choose recorded, live-online or in-person learning that fits your goals and schedule.</p></article>
      <article><span>02</span><h3>Practise with purpose</h3><p>Use assessments, flashcards and resources to reinforce what you learn.</p></article>
      <article><span>03</span><h3>See your progress</h3><p>Keep completed lessons, results and upcoming sessions clear and connected.</p></article>
    </div>
  </section>

  <section class="journey-section" id="how-it-works">
    <div class="shell">
      <div class="landing-section-heading"><div><span class="eyebrow">Simple by design</span><h2>From curiosity to measurable progress.</h2></div><p>Every part of the journey stays connected, so learning does not end when a video does.</p></div>
      <ol class="journey-steps">{learningSteps.map((step) => <li><span>{step.number}</span><h3>{step.title}</h3><p>{step.copy}</p></li>)}</ol>
    </div>
  </section>

  <section class="section shell capability-section" id="learning-formats">
    <div class="center-heading"><span class="eyebrow">Built for complete learning journeys</span><h2>More than watching videos.</h2><p>Course tiles show exactly which formats and activities are included before you book.</p></div>
    <div class="capability-grid">{capabilities.map((item) => <article><span aria-hidden="true">{item.mark}</span><div><h3>{item.title}</h3><p>{item.copy}</p></div></article>)}</div>
  </section>

  <section class="connection-section">
    <div class="shell connection-grid">
      <div><span class="eyebrow eyebrow-light">Progress is better with support</span><h2>Learn independently.<br />Not alone.</h2><p>Build a private network of tutors, mentors, peers or study partners. Exchange messages and choose who can see your learning progress.</p><a class="button button-light" href="/register?next=/network">Build your network</a></div>
      <div class="connection-panel">
        <div class="connection-people" aria-hidden="true"><span>JT</span><i></i><span>AL</span><i></i><span>SK</span></div>
        <ul><li>Ask for help when you need it</li><li>Share milestones with trusted people</li><li>Help tutors understand where support is needed</li><li>Keep progress private until you choose to share it</li></ul>
        <p><strong>Your progress is not public.</strong> It is shared only with connections you approve.</p>
      </div>
    </div>
  </section>

  <section class="section shell creator-section" id="for-creators">
    <div class="creator-grid">
      <div><span class="eyebrow">Have knowledge worth sharing?</span><h2>Publish one useful thing—or a complete course.</h2><p>Create a standalone ebook, quiz, test, mock exam, video, audio lesson or reading. When the subject needs a fuller journey, combine formats into a complete course.</p><div class="creator-actions"><a class="button button-accent" href="/register?next=/create">Start creating</a><a class="text-link" href="/create">See creator options <span>→</span></a></div></div>
      <div class="creator-benefits"><article><span>01</span><div><h3>Create once</h3><p>Build reusable modules, lessons, assessments, flashcards and resources.</p></div></article><article><span>02</span><div><h3>Offer it your way</h3><p>Run recorded courses, live cohorts, in-person classes or hybrid experiences.</p></div></article><article><span>03</span><div><h3>Support every learner</h3><p>Manage enrolments, communicate and understand learner progress.</p></div></article></div>
    </div>
  </section>

  <section class="signup-band">
    <div class="shell signup-band-inner"><div><span class="eyebrow">Your next course starts here</span><h2>Ready to learn something valuable?</h2><p>Browse courses, book the experience that suits you, practise what you learn and keep your progress in one place.</p></div><div><a class="button button-light" href="/register?next=/courses">Sign up free</a><a class="signup-secondary" href="/courses">Browse courses first →</a><a class="creator-small-link" href="/register?next=/tutor">Want to share your knowledge? Create a course →</a></div></div>
  </section>

  <section class="section shell faq-section">
    <div class="landing-section-heading"><div><span class="eyebrow">Good to know</span><h2>Questions before you begin?</h2></div><p>One flexible account keeps learning and creating simple.</p></div>
    <div class="faq-grid">
      <details open><summary>Is PencilScope only for students?</summary><p>No. It is for anyone who wants to learn or share useful knowledge, including students, professionals, tutors, coaches and independent creators.</p></details>
      <details><summary>Do I need a separate creator account?</summary><p>No. Every registered member can learn, publish standalone learning products and create complete courses from the same account.</p></details>
      <details><summary>Does an ebook or quiz need to belong to a course?</summary><p>No. Ebooks, readings, quizzes, tests, mock exams, videos and audio can be published and discovered independently. Creators can also build these formats directly into a complete course.</p></details>
      <details><summary>Can other people see my progress?</summary><p>Not automatically. Progress is only shared with connections you approve.</p></details>
      <details><summary>Does every course include every feature?</summary><p>No. Each course tile shows the formats and activities actually included in that course.</p></details>
      <details><summary>Is registration free?</summary><p>Creating an account is free. Individual courses may be free or paid depending on the creator's offering.</p></details>
    </div>
  </section>
</BaseLayout>
