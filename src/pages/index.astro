---
import CourseCard from "@/components/CourseCard.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { listPublishedCourses } from "@/lib/api-client";

const courses = (await listPublishedCourses()).slice(0, 3);
---

<BaseLayout>
  <section class="hero">
    <div class="shell hero-grid">
      <div class="hero-copy">
        <span class="eyebrow">Learning made human</span>
        <h1>Big ideas begin with a <em>little curiosity.</em></h1>
        <p>Recorded courses, live online learning and in-person experiences created by people with something valuable to share.</p>
        <div class="hero-actions"><a class="button" href="/courses">Explore courses</a><a class="button button-ghost" href="#how-it-works"><span class="play">▶</span> See how it works</a></div>
        <div class="trust-row"><div class="avatar-stack" aria-hidden="true"><span>JT</span><span>AL</span><span>SK</span></div><p><strong>Learning for every stage</strong><br />Academic, enrichment and professional growth</p></div>
      </div>
      <div class="hero-art" aria-label="A playful illustration representing guided learning">
        <div class="orbit orbit-one"></div><div class="orbit orbit-two"></div>
        <div class="book-card"><span class="spark spark-one">✦</span><span class="spark spark-two">✦</span><div class="book-page left"><span></span><span></span><span></span></div><div class="book-spine"></div><div class="book-page right"><span></span><span></span><span></span></div></div>
        <div class="floating-note note-one"><span>✓</span> Weekly goals</div><div class="floating-note note-two"><span>★</span> Great progress!</div><span class="doodle doodle-one">∿</span><span class="doodle doodle-two">＋</span>
      </div>
    </div>
    <div class="subject-ribbon" aria-label="Learning formats available"><span>Academic</span><i></i><span>Enrichment</span><i></i><span>Masterclasses</span><i></i><span>Seminars</span><i></i><span>Knowledge sharing</span></div>
  </section>

  <section class="section shell">
    <div class="section-heading"><div><span class="eyebrow">Made for curious minds</span><h2>Courses worth showing up for</h2></div><a class="text-link" href="/courses">Browse all courses <span>→</span></a></div>
    <div class="course-grid">{courses.map((course) => <CourseCard course={course} />)}</div>
  </section>

  <section class="how-section" id="how-it-works">
    <div class="shell">
      <div class="center-heading"><span class="eyebrow">Simple by design</span><h2>Learning that fits real life</h2><p>Start with a goal. Choose how you want to learn.</p></div>
      <div class="steps-grid">
        <article><span class="step-number">01</span><div class="step-icon">⌕</div><h3>Find the right fit</h3><p>Explore courses by topic, category, schedule and delivery format.</p></article>
        <article><span class="step-number">02</span><div class="step-icon">⌁</div><h3>Learn your way</h3><p>Watch recorded lessons, join a live cohort or meet in person.</p></article>
        <article><span class="step-number">03</span><div class="step-icon">↗</div><h3>Put knowledge to work</h3><p>Use materials, practice, assessments and shared sessions to keep progressing.</p></article>
      </div>
    </div>
  </section>

  <section class="tutor-band" id="for-tutors">
    <div class="shell tutor-grid">
      <div><span class="eyebrow eyebrow-light">For every creator</span><h2>Share your way.<br />Reach more learners.</h2><p>Build a recorded course, run live classes, host a seminar or bring learners together in person.</p><a class="button button-light" href="/tutor">Create a course</a></div>
      <div class="tutor-quote"><span class="quote-mark">“</span><blockquote>If you have useful knowledge and a thoughtful way to share it, PencilScope gives you a place to build the learning journey.</blockquote><p>Open creator platform · Singapore</p></div>
    </div>
  </section>
</BaseLayout>
