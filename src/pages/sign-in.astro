---
import BaseLayout from "@/layouts/BaseLayout.astro";
const error = Astro.url.searchParams.get("error");
const requestedNext = Astro.url.searchParams.get("next");
const next = requestedNext?.startsWith("/") && !requestedNext.startsWith("//") ? requestedNext : "/dashboard";
---
<BaseLayout title="Sign in — PencilScope">
  <section class="auth-shell shell">
    <div class="auth-card">
      <span class="eyebrow">Welcome back</span>
      <h1>Sign in to keep learning</h1>
      <p>Open learner courses, manage progress, or continue building your tutor content.</p>
      {error && <p class="form-error" role="alert">{error}</p>}
      <form class="stack-form" action="/api/auth/login" method="post">
        <input type="hidden" name="next" value={next} />
        <label>Email<input name="email" required type="email" autocomplete="email" /></label>
        <label>Password<input name="password" required type="password" autocomplete="current-password" /></label>
        <button class="button button-full" type="submit">Sign in</button>
      </form>
      <a class="text-link" href="/register">Create an account</a>
    </div>
  </section>
</BaseLayout>
