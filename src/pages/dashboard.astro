      {workspace === "learning" && section === "learning" && selectedLearningProduct && <article class="panel dashboard-section-panel inline-product-workspace">
        <div class="dashboard-section-heading"><div><span class="eyebrow">Learning workspace · {selectedLearningProduct.product_type.replaceAll("_", " ")}</span><h2>{selectedLearningProduct.title}</h2><p>Learn, save progress and complete activities without leaving My Learning.</p></div><div class="learning-header-actions"><a class="button button-small button-secondary" href={`/library/${selectedLearningProduct.slug}`}>Open full screen</a><a class="text-link" href="/dashboard?workspace=learning&section=learning">Close</a></div></div>
        <iframe class="inline-product-frame" src={`/library/${selectedLearningProduct.slug}?embedded=1`} title={`${selectedLearningProduct.title} learning activity`} loading="eager"></iframe>
      </article>}
      {workspace === "learning" && section === "learning" && inlineLearningCourse && selectedLearningEnrolment && <article class="panel dashboard-section-panel inline-learning-workspace">
        <div class="dashboard-section-heading"><div><span class="eyebrow">Learning workspace · {selectedLearningEnrolment.offering_title}</span><h2>{inlineLearningCourse.course.title}</h2><p>{inlineLearningCourse.course.description}</p></div><div class="learning-header-actions"><a class="button button-small button-secondary" href={`/learn/${inlineLearningCourse.course.id}${selectedLearningStudentQuery}`}>Open full screen</a><a class="text-link" href="/dashboard?workspace=learning&section=learning">Close</a></div></div>
        <div class="inline-learning-summary"><section><strong>{Math.round(selectedLearningEnrolment.progress_percent)}%</strong><span>Overall progress</span><progress value={selectedLearningEnrolment.progress_percent} max="100"></progress></section><section><strong>{inlineLearningCourse.modules.length}</strong><span>Modules</span><small>{inlineLearningCourse.lessons.length} learning activities</small></section><section><strong>{inlineLearningCourse.assessments.length}</strong><span>Assessments</span><small>Quizzes, tests and exams</small></section></div>
        {inlineLearningCourse.sessions.filter((session) => new Date(session.ends_at).getTime() >= Date.now()).slice(0, 1).map((session) => <section class="inline-next-session"><div><span class="eyebrow">Next scheduled class</span><h3>{session.title}</h3><p>{new Date(session.starts_at).toLocaleString("en-SG", { dateStyle: "full", timeStyle: "short" })} · {session.timezone}</p></div>{session.delivery_mode === "live_online" && session.meeting_url ? <a class="button button-small" href={session.meeting_url} target="_blank" rel="noreferrer">Join online class</a> : <span>{[session.venue_name, session.address_line_1, session.postal_code].filter(Boolean).join(", ")}</span>}</section>)}
        <div class="inline-module-list">{inlineLearningCourse.modules.map((module) => <section><header><span>{String(module.position).padStart(2, "0")}</span><h3>{module.title}</h3></header>{inlineLearningCourse.lessons.filter((lesson) => lesson.module_id === module.id).map((lesson) => { const content = JSON.parse(lesson.content_json || "{}"); const assessment = inlineLearningCourse.assessments.find((item) => item.lesson_id === lesson.id); const deck = inlineLearningCourse.flashcardDecks.find((item) => item.lesson_id === lesson.id); return <article class:list={{ complete: lesson.progress_status === "completed" }}><div><strong>{lesson.title}</strong><small>{content.summary ?? "Creator-guided learning activity."} · {lesson.estimated_minutes ? `${lesson.estimated_minutes} min` : "Self-paced"}</small></div><div>{assessment && <a class="button button-small" href={`/assessment/${assessment.id}${selectedLearningStudentQuery}`}>Start {assessment.assessment_type.replaceAll("_", " ")}</a>}{deck && <a class="button button-small" href={`/flashcards/${deck.id}${selectedLearningStudentQuery}`}>Study cards</a>}{!assessment && !deck && lesson.progress_status !== "completed" && <form class="inline-complete-form" action={`/api/learning/lessons/${lesson.id}/complete`} method="post"><input type="hidden" name="courseId" value={inlineLearningCourse.course.id} /><input type="hidden" name="studentId" value={selectedLearningEnrolment.student_user_id === data.user.id ? "" : selectedLearningEnrolment.student_user_id} /><button class="button button-small" type="submit">Mark complete</button></form>}{lesson.progress_status === "completed" && <strong class="complete-label">✓ Complete</strong>}</div></article>; })}</section>)}</div>
      </article>}
      {workspace === "learning" && section === "learning" && <article class="panel dashboard-section-panel enrolled-learning-panel"><div class="dashboard-section-heading"><div><span class="eyebrow">Your learning</span><h2>All enrolled products</h2><p>Continue courses, books, media and assessments from one place.</p></div><div class="learning-header-actions"><span>{learningItemCount} product{learningItemCount === 1 ? "" : "s"}</span><a class="button button-small button-secondary" href="/courses">Explore learning</a></div></div><nav class="learning-filter-bar" aria-label="Filter enrolled products">{[{ key: "all", label: "All" }, { key: "courses", label: "Courses" }, { key: "books", label: "Books & audio" }, { key: "media", label: "Video & reading" }, { key: "assessments", label: "Assessments" }].map((filter) => <a class:list={{ active: requestedLearningFilter === filter.key }} aria-current={requestedLearningFilter === filter.key ? "page" : undefined} href={`/dashboard?workspace=learning&section=learning&kind=${filter.key}`}>{filter.label}</a>)}</nav><nav class="learning-filter-bar learning-state-filter" aria-label="Filter learning status">{[{ key: "all", label: "All progress" }, { key: "active", label: "In progress" }, { key: "completed", label: "Completed" }].map((filter) => <a class:list={{ active: requestedLearningState === filter.key }} href={`/dashboard?workspace=learning&section=learning&kind=${requestedLearningFilter}&state=${filter.key}`}>{filter.label}</a>)}</nav>{visibleCourseEnrolments.length || visibleLearningProducts.length ? <div class="product-grid dashboard-product-grid enrolled-product-grid">{visibleCourseEnrolments.map((enrolment) => { const progress = Math.round(enrolment.progress_percent); const highlighted = enrolment.course_id === enrolledCourseId; return <article class:list={["product-card", "learning-course-card", { "newly-enrolled-card": highlighted }]}><a class="product-card-link" href={`/dashboard?workspace=learning&section=learning&courseId=${encodeURIComponent(enrolment.course_id)}`}><div class="product-card-top"><ProductIcon name="course" /><span class="product-type">Course</span><span class="product-price product-access-active">{highlighted ? "New" : "Enrolled"}</span></div><div class="product-card-body"><span class="eyebrow">{enrolment.subject}</span><h2>{enrolment.title}</h2><p>Continue your learning through the modules and products included with this enrolment.</p><div class="product-card-meta"><span>{enrolment.offering_title}</span><span>{progress >= 100 ? "Completed" : `${progress}% complete`}</span></div><progress class="learning-card-progress" value={progress} max="100"></progress></div><div class="product-card-footer"><span>Included with {enrolment.offering_title}</span><strong>{progress >= 100 ? "Review" : progress > 0 ? "Continue" : "Start"} →</strong></div></a></article>; })}{visibleLearningProducts.map((product) => <LearningProductCard product={product} mode="learning" href={`/dashboard?workspace=learning&section=learning&learningProductId=${encodeURIComponent(product.id)}`} highlighted={Boolean(enrolledCourseSlug && product.offer_course_slug === enrolledCourseSlug)} />)}</div> : <div class="dashboard-empty"><h3>{learningItemCount ? "No products match this filter" : "Your learning space is ready"}</h3><p>{learningItemCount ? "Choose another product type to continue learning." : "Enrol in a course or add a learning product to begin."}</p><a class="button button-small" href={learningItemCount ? "/dashboard?workspace=learning&section=learning&kind=all" : "/courses"}>{learningItemCount ? "Show all products" : "Explore learning"}</a></div>}</article>}

      {workspace === "learning" && section === "results" && <><article class="panel dashboard-section-panel"><div class="dashboard-section-heading"><div><span class="eyebrow">Course assessments</span><h2>Course attempt history</h2><p>Quiz, test and mock-exam results from your enrolled courses.</p></div></div>{learningResults.courseAttempts.length ? <div class="result-history">{learningResults.courseAttempts.map((attempt) => <section><div><strong>{attempt.title}</strong><small>{attempt.course_title} · {attempt.assessment_type.replaceAll("_", " ")}</small></div><span class:list={["result-score", { passed: attempt.passed }]}>{attempt.score === null ? attempt.status : `${attempt.score}%`}</span><small>{new Date(attempt.submitted_at ?? attempt.started_at).toLocaleString("en-SG")}</small></section>)}</div> : <p class="form-message">No course assessment attempts yet.</p>}</article><article class="panel dashboard-section-panel"><div class="dashboard-section-heading"><div><span class="eyebrow">Learning assessments</span><h2>Product attempt history</h2><p>Results from quizzes, tests and mock exams in your learning library.</p></div></div>{learningResults.standaloneAttempts.length ? <div class="result-history">{learningResults.standaloneAttempts.map((attempt) => <section><div><strong>{attempt.title}</strong><small>{attempt.product_type.replaceAll("_", " ")}</small></div><span class:list={["result-score", { passed: attempt.passed }]}>{attempt.score}%</span><small>{new Date(attempt.submitted_at).toLocaleString("en-SG")}</small></section>)}</div> : <p class="form-message">No learning product assessment attempts yet.</p>}</article></>}

      {workspace === "learning" && section === "payments" && <article class="panel dashboard-section-panel learner-payments-inline"><div class="dashboard-section-heading"><div><span class="eyebrow">Your purchases</span><h2>Learning payment history</h2><p>Review the amount, date and status of every learning purchase.</p></div></div>{creatorPayments.purchases.length ? <div class="data-table-wrap"><table class="data-table"><thead><tr><th>Learning product</th><th>Date</th><th>Status</th><th>Amount</th><th>Help</th></tr></thead><tbody>{creatorPayments.purchases.map((payment) => <tr><td><strong>{payment.course_title}</strong><small>{payment.offering_title}</small></td><td>{new Date(payment.created_at).toLocaleString("en-SG")}</td><td><span class:list={["settlement-status", payment.issue_status ? "held" : payment.status]}>{payment.issue_status ? "Issue under review" : payment.status}</span></td><td>{money(payment.amount_cents, payment.currency)}</td><td>{payment.status === "paid" && !payment.issue_status ? <details class="payment-issue"><summary>Report issue</summary><form class="payment-issue-form" data-order-id={payment.id}><label>What went wrong?<textarea name="reason" minlength="10" maxlength="2000" rows="3" required></textarea></label><label>Request type<select name="caseType"><option value="service_issue">Learning service issue</option><option value="refund_request">Request a refund review</option></select></label><button class="button button-secondary button-small" type="submit">Send for review</button><p class="form-message" aria-live="polite"></p></form></details> : payment.issue_status ? <small>We will review this before releasing the creator payout.</small> : "—"}</td></tr>)}</tbody></table></div> : <div class="dashboard-empty"><h3>No learning payments yet</h3><p>Your completed purchases will appear here.</p><a class="button button-small" href="/courses">Explore learning</a></div>}</article>}

      {workspace === "creation" && section === "getting-started" && <article class="panel dashboard-section-panel getting-started-panel">
