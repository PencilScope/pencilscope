          {enrolments.length ? <><div class="learning-progress-chart" aria-label="Course progress chart">{enrolments.slice(0, 6).map((enrolment) => { const progress = Math.round(enrolment.progress_percent); return <a href={`/dashboard?workspace=learning&section=learning&courseId=${encodeURIComponent(enrolment.course_id)}`}><span>{enrolment.title}</span><i><b style={`width:${progress}%`}></b></i><strong>{progress}%</strong></a>; })}</div><div class="dashboard-learning-list">{enrolments.slice(0, 6).map((enrolment) => { const progress = Math.round(enrolment.progress_percent); return <a href={`/dashboard?workspace=learning&section=learning&courseId=${encodeURIComponent(enrolment.course_id)}`}><div><span>{enrolment.subject} · {enrolment.offering_title}</span><strong>{enrolment.title}</strong></div><div class="learning-row-progress"><small>{progress}% complete</small><progress value={progress} max="100"></progress></div><b>Open inline</b></a>; })}</div></> : <div class="dashboard-empty"><h3>Your learning space is ready</h3><p>Explore courses and learning products to begin.</p><a class="button button-small" href="/courses">Explore learning</a></div>}
        </article>
