      {workspace === "creation" && section === "course-studio" && <article class="panel dashboard-section-panel inline-course-studio">
        <div class="dashboard-section-heading"><div><span class="eyebrow">Course studio</span><h2>Build and deliver your course</h2><p>Choose a course, update its draft details and schedule online classes without leaving your Creation Workspace.</p></div><a class="button button-small button-secondary" href="/tutor">Open full screen</a></div>
        <div class="inline-studio-toolbar"><nav aria-label="Choose a course">{data.creatorCourses?.map((course) => <a class:list={{ active: course.id === selectedCourseId }} href={`/dashboard?workspace=creation&section=course-studio&courseId=${course.id}`}><strong>{course.title}</strong><small>{course.status} · {course.pricing_status}</small></a>)}</nav><details open={!data.creatorCourses?.length}><summary class="button button-small">+ Create course</summary><form class="inline-studio-form dashboard-api-form" data-kind="course" action="/api/tutor/courses"><div class="inline-editor-grid"><label>Course title<input name="title" required minlength="3" /></label><label>Topic<input name="subject" required /></label><label>Audience<input name="primaryLevel" required /></label><label>Primary delivery<select name="deliveryMode"><option value="self-paced">Recorded / self-paced</option><option value="live">Live online</option><option value="hybrid">Hybrid</option><option value="ai-supported">AI-supported</option></select></label><label>Category<select name="categorySlug"><option value="academic">Academic</option><option value="enrichment">Enrichment</option><option value="personal-development">Personal development</option><option value="professional-development">Professional development</option><option value="masterclass">Masterclass</option><option value="knowledge-sharing">Knowledge sharing</option></select></label></div><label>Description<textarea name="description" required minlength="20" rows="4"></textarea></label><p class="meet-assurance"><strong>Draft first:</strong> Add course content before creating its priced offer. Online classes receive Google Meet links when scheduled using the course owner’s connected Google Calendar. <a href="/profile">Check connection settings</a>.</p><button class="button button-small" type="submit">Save draft and continue</button><p class="form-message" aria-live="polite"></p></form></details></div>
        {inlineStudioError && <p class="form-error">{inlineStudioError}</p>}
        {!selectedCourseId && <div class="dashboard-empty"><h3>No course selected</h3><p>Create a course draft to begin.</p></div>}
        {inlineStudio && <div class="inline-studio-content"><section class="inline-studio-heading"><div><span class:list={["performance-status", inlineStudio.course.status === "published" && inlineStudio.course.listing_status !== "listed" ? "unpublished" : inlineStudio.course.status]}>{inlineStudio.course.status === "published" && inlineStudio.course.listing_status !== "listed" ? "unpublished" : inlineStudio.course.status}</span><h3>{inlineStudio.course.title}</h3><p>{inlineStudio.course.description}</p></div><div class="inline-studio-facts"><span><strong>{inlineStudio.modules.length}</strong> modules</span><span><strong>{inlineStudio.lessons.length}</strong> lessons</span><span><strong>{inlineStudio.offerings.length}</strong> offers</span><span><strong>{inlineStudio.sessions.length}</strong> sessions</span></div></section>
          <details class="studio-editor" open={Astro.url.searchParams.get("edit") === "details" || inlineStudio.course.status === "draft"}><summary>Edit course details</summary><form class="inline-studio-form dashboard-api-form" data-method="PATCH" action={`/api/tutor/courses/${inlineStudio.course.id}`}><div class="inline-editor-grid"><label>Title<input name="title" required minlength="3" value={inlineStudio.course.title} /></label><label>Topic<input name="subject" required value={inlineStudio.course.subject} /></label><label>Audience<input name="primaryLevel" required value={inlineStudio.course.primary_level} /></label><label>Primary delivery<select name="deliveryMode"><option value="self-paced" selected={inlineStudio.course.delivery_mode === "self-paced"}>Recorded / self-paced</option><option value="live" selected={inlineStudio.course.delivery_mode === "live"}>Live online</option><option value="hybrid" selected={inlineStudio.course.delivery_mode === "hybrid"}>Hybrid</option><option value="ai-supported" selected={inlineStudio.course.delivery_mode === "ai-supported"}>AI-supported</option></select></label></div><label>Description<textarea name="description" required minlength="20" rows="4">{inlineStudio.course.description}</textarea></label><button class="button button-small" type="submit">Save course changes</button><p class="form-message" aria-live="polite"></p></form></details>
          <section class="inline-session-panel"><div class="dashboard-section-heading"><div><span class="eyebrow">Online and in-person classes</span><h3>Scheduled sessions</h3><p>Every online session gets its own restricted Google Meet link and calendar invitations for the assigned host and enrolled learners.</p></div>{inlineStudio.offerings.length > 1 && <form method="get" action="/dashboard"><input type="hidden" name="workspace" value="creation" /><input type="hidden" name="section" value="course-studio" /><input type="hidden" name="courseId" value={inlineStudio.course.id} /><select name="offeringId" onchange="this.form.submit()">{inlineStudio.offerings.map((offering) => <option value={offering.id} selected={offering.id === selectedStudioOfferingId}>{offering.title}</option>)}</select></form>}</div>
            {!selectedStudioOffering && <p class="form-message">Create and price an offering in the advanced studio before scheduling a class.</p>}
            {selectedStudioOffering && <><form class="inline-studio-form dashboard-api-form session-scheduler" data-kind="session" action={`/api/tutor/offerings/${selectedStudioOffering.id}/sessions`}><div class="inline-editor-grid"><label>Session title<input name="title" required /></label><label>Delivery<select name="deliveryMode"><option value="live_online">Live online · Google Meet</option><option value="in_person">In person</option></select></label><label>Starts<input name="startsAt" type="datetime-local" required /></label><label>Ends<input name="endsAt" type="datetime-local" required /></label><label>Assigned host<select name="instructorId"><option value={data.user.id}>Me</option>{studioTeam.filter((member) => member.user_id !== data.user.id && member.status === "active" && ["owner", "administrator", "instructor", "facilitator"].includes(member.member_role)).map((member) => <option value={member.user_id}>{member.display_name} · {member.member_role.replace("instructor", "co-host")}</option>)}</select></label><label>Capacity<input name="capacity" type="number" min="1" /></label><label>Venue name<input name="venueName" /></label><label>Venue address<input name="venueAddress" /></label></div><label>Arrival instructions<textarea name="arrivalInstructions" rows="2"></textarea></label><p class="meet-assurance">Live online sessions automatically create the Google Meet link. Planned session time must fit the meeting allowance included in the published offer price.</p><button class="button button-small" type="submit">Schedule session</button><p class="form-message" aria-live="polite"></p></form><div class="inline-session-list">{inlineStudio.sessions.filter((session) => session.course_offering_id === selectedStudioOffering.id).map((session) => <article><div><strong>{session.title}</strong><small>{new Date(session.starts_at).toLocaleString("en-SG")} – {new Date(session.ends_at).toLocaleTimeString("en-SG", { hour: "2-digit", minute: "2-digit" })}{session.instructor_name ? ` · ${session.instructor_name}` : ""}</small></div><span>{session.delivery_mode === "live_online" ? "Online" : "In person"}</span>{session.meeting_url && <a class="text-link" href={session.meeting_url} target="_blank" rel="noreferrer">Open Google Meet</a>}</article>)}</div></>}
          </section>
        </div>}
      </article>}

      {workspace === "creation" && section === "payments" && <article class="panel dashboard-section-panel creator-payments-inline"><div class="dashboard-section-heading"><div><span class="eyebrow">Content sales</span><h2>Payments received from learners</h2><p>Review gross sales, deductions, net earnings and the release status for every creator-owned sale.</p></div></div>{creatorPayments.creatorSummary.length ? <div class="settlement-summary">{creatorPayments.creatorSummary.map((summary) => <><section><small>Paid by learners · {summary.currency}</small><strong>{money(summary.gross_cents, summary.currency)}</strong></section><section><small>Number of payments</small><strong>{creatorPayments.creatorSales.filter((sale) => sale.currency === summary.currency && sale.status === "paid").length}</strong></section><section><small>Pending release</small><strong>{money(summary.pending_cents, summary.currency)}</strong></section><section><small>Paid out</small><strong>{money(summary.transferred_cents, summary.currency)}</strong></section></>)}</div> : <p class="form-message">No learner payments have been received yet.</p>}{creatorPayments.creatorSales.length > 0 && <div class="data-table-wrap"><table class="data-table"><thead><tr><th>Received</th><th>Learner</th><th>Content sold</th><th>Gross paid</th><th>Fees and adjustments</th><th>Net earning</th><th>Status</th></tr></thead><tbody>{creatorPayments.creatorSales.map((payment) => <tr><td>{new Date(payment.created_at).toLocaleString("en-SG")}</td><td><strong>{payment.learner_name}</strong><small>{payment.learner_email}</small></td><td><strong>{payment.course_title}</strong><small>{payment.offering_title}</small></td><td>{money(payment.gross_cents ?? payment.amount_cents, payment.currency)}</td><td><small>Processing {money(payment.processing_fee_cents, payment.currency)}<br />Platform {money(payment.platform_fee_cents, payment.currency)}<br />Online class {money(payment.meeting_usage_fee_cents, payment.currency)}{Number(payment.refund_cents ?? 0) > 0 && <><br />Refund {money(payment.refund_cents, payment.currency)}</>}</small></td><td><strong>{money(payment.payable_cents ?? payment.amount_cents, payment.currency)}</strong></td><td><span class:list={["settlement-status", payment.settlement_status ?? "pending_course"]}>{settlementLabel(payment.settlement_status)}</span>{payment.transferred_at && <small>Paid {new Date(payment.transferred_at).toLocaleString("en-SG")}</small>}</td></tr>)}</tbody></table></div>}</article>}

      {workspace === "creation" && section === "activity" && creatorOverview && <article class="panel dashboard-section-panel"><div class="dashboard-section-heading"><div><span class="eyebrow">Detailed audit trail</span><h2>Creation activity</h2></div><a class="button button-small button-secondary" href="/action-history">Open full screen</a></div><div class="audit-list">{creatorOverview.auditLogs.map((entry) => <section><span class="audit-mark" aria-hidden="true">•</span><div><strong>{entry.action.replaceAll(".", " ").replaceAll("_", " ")}</strong><small>{entry.entity_type.replaceAll("_", " ")} · {entry.actor_name}</small></div><time datetime={entry.created_at}>{new Date(entry.created_at).toLocaleString("en-SG")}</time></section>)}</div>{!creatorOverview.auditLogs.length && <p class="form-message">Creator activity will be recorded here.</p>}</article>}
    </main>
  </section>
</BaseLayout>

<script>
  document.querySelectorAll<HTMLFormElement>(".inline-complete-form").forEach((form) => {
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (button) { button.disabled = true; button.textContent = "Saving…"; }
      const response = await fetch(form.action, { method: "POST", body: new FormData(form) });
      if (response.ok) window.location.reload();
      else if (button) { button.disabled = false; button.textContent = "Try again"; }
    });
  });
  document.querySelector<HTMLElement>("[data-export-performance]")?.addEventListener("click", () => {
    const table = document.querySelector<HTMLTableElement>("[data-performance-table]");
    if (!table) return;
    const rows = [...table.querySelectorAll("tr")].map((row) =>
      [...row.querySelectorAll("th,td")].map((cell) => `"${(cell.textContent ?? "").trim().replace(/\s+/g, " ").replaceAll('"', '""')}"`).join(",")
    );
    const blob = new Blob([rows.join("\n")], { type: "text/csv;charset=utf-8" });
    const link = document.createElement("a");
    link.href = URL.createObjectURL(blob);
    link.download = `pencilscope-content-performance-${new Date().toISOString().slice(0, 10)}.csv`;
    link.click();
    URL.revokeObjectURL(link.href);
  });

  document.querySelectorAll<HTMLFormElement>(".dashboard-draft-form").forEach((form) => {
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const message = form.querySelector<HTMLElement>(".form-message");
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      const values = Object.fromEntries(new FormData(form).entries()) as Record<string, string>;
      const payload: Record<string, unknown> = { ...values };
      if (form.dataset.kind === "product") {
        payload.estimatedMinutes = Number(values.estimatedMinutes);
        payload.metadataOnly = true;
      }
      button?.setAttribute("disabled", "");
      if (message) { message.textContent = "Saving…"; message.className = "form-message"; }
      try {
        const response = await fetch(form.action, {
          method: "PATCH",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload)
        });
        const result = await response.json() as { error?: { message?: string } };
        if (!response.ok) throw new Error(result.error?.message ?? "Draft could not be saved.");
        if (message) { message.textContent = "Draft saved."; message.className = "form-message form-success"; }
        const title = form.closest<HTMLElement>(".content-manager-item")?.querySelector<HTMLElement>(".content-manager-title > strong");
        if (title) title.textContent = values.title;
      } catch (error) {
        if (message) { message.textContent = error instanceof Error ? error.message : "Draft could not be saved."; message.className = "form-message form-error"; }
      } finally {
        button?.removeAttribute("disabled");
      }
    });
  });

  document.querySelectorAll<HTMLDetailsElement>(".inline-draft-editor").forEach((editor) => {
    editor.addEventListener("toggle", () => {
      if (!editor.open) return;
      document.querySelectorAll<HTMLDetailsElement>(".inline-draft-editor[open]").forEach((other) => {
        if (other !== editor) other.open = false;
      });
    });
  });

  document.querySelectorAll<HTMLFormElement>(".dashboard-api-form").forEach((form) => {
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const message = form.querySelector<HTMLElement>(".form-message");
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      const values = Object.fromEntries(new FormData(form).entries()) as Record<string, string>;
      let body: Record<string, unknown> = { ...values };
      if (form.dataset.kind === "course") {
        body = {
          ...values,
          categorySlugs: values.categorySlug ? [values.categorySlug] : [],
          priceCents: values.priceSGD ? Math.round(Number(values.priceSGD) * 100) : 50,
          currency: "SGD",
          publish: false
        };
        delete body.priceSGD;
        delete body.categorySlug;
      }
      if (form.dataset.kind === "session") {
        body = {
          ...values,
          capacity: values.capacity ? Number(values.capacity) : null,
          startsAt: new Date(values.startsAt).toISOString(),
          endsAt: new Date(values.endsAt).toISOString(),
          timezone: "Asia/Singapore"
        };
      }
      if (button) button.disabled = true;
      if (message) { message.className = "form-message"; message.textContent = form.dataset.kind === "session" ? "Creating Google Meet and sending calendar invitations…" : "Saving…"; }
      try {
        const response = await fetch(form.action, {
          method: form.dataset.method ?? "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(body)
        });
        const result = await response.json() as { course?: { id?: string }; error?: { message?: string } };
        if (!response.ok) throw new Error(result.error?.message ?? "Could not save.");
        if (message) { message.className = "form-message form-success"; message.textContent = form.dataset.kind === "session" ? "Session and Google Meet created." : "Saved."; }
        if ((form.dataset.method ?? "POST").toUpperCase() === "PATCH") {
          if (button) button.disabled = false;
          return;
        }
        const current = new URL(window.location.href);
        const courseId = result.course?.id ?? current.searchParams.get("courseId");
        window.location.href = `/dashboard?workspace=creation&section=course-studio${courseId ? `&courseId=${encodeURIComponent(courseId)}` : ""}${current.searchParams.get("offeringId") ? `&offeringId=${encodeURIComponent(current.searchParams.get("offeringId") ?? "")}` : ""}`;
      } catch (error) {
        if (message) { message.className = "form-message form-error"; message.textContent = error instanceof Error ? error.message : "Could not save."; }
        if (button) button.disabled = false;
      }
    });
  });

  document.querySelectorAll<HTMLFormElement>(".product-dashboard-action").forEach((form) => {
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (form.dataset.confirm && !window.confirm(form.dataset.confirm)) return;
      const message = form.querySelector<HTMLElement>(".form-message");
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (button) button.disabled = true;
      if (message) { message.className = "form-message"; message.textContent = "Updating…"; }
      try {
        const response = await fetch(form.action, {
          method: form.dataset.method ?? "POST",
          headers: { "Content-Type": "application/json" },
          body: "{}"
        });
        const result = await response.json() as { product?: { id?: string }; error?: { message?: string } };
        if (!response.ok) throw new Error(result.error?.message ?? "The product could not be updated.");
        if (form.dataset.success === "version" && result.product?.id) {
          window.location.href = `/dashboard?workspace=creation&section=product&productId=${encodeURIComponent(result.product.id)}`;
          return;
        }
        if (form.dataset.method === "DELETE") {
          window.location.href = "/dashboard?workspace=creation&section=content";
          return;
        }
        window.location.reload();
      } catch (error) {
        if (message) { message.className = "form-message form-error"; message.textContent = error instanceof Error ? error.message : "The product could not be updated."; }
        if (button) button.disabled = false;
      }
    });
  });

  document.querySelectorAll<HTMLFormElement>(".payment-issue-form").forEach((form) => {
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      const message = form.querySelector<HTMLElement>(".form-message");
      const values = new FormData(form);
      if (button) button.disabled = true;
      if (message) { message.className = "form-message"; message.textContent = "Sending your issue for review…"; }
      try {
        const response = await fetch(`/api/payments/${encodeURIComponent(form.dataset.orderId ?? "")}/issues`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ reason: values.get("reason"), caseType: values.get("caseType") })
        });
        const result = await response.json() as { error?: { message?: string } };
        if (!response.ok) throw new Error(result.error?.message ?? "The issue could not be submitted.");
        if (message) { message.className = "form-message form-success"; message.textContent = "Issue received. The creator payout is on hold while it is reviewed."; }
        form.querySelectorAll<HTMLElement>("input, textarea, select")
          .forEach((field) => field.setAttribute("disabled", ""));
      } catch (error) {
        if (message) { message.className = "form-message form-error"; message.textContent = error instanceof Error ? error.message : "The issue could not be submitted."; }
        if (button) button.disabled = false;
      }
    });
  });
</script>
