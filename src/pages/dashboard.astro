</p></form></div>}{selectedProduct.display_status === "unpublished" && <div class="settings-action-row"><div><strong>Republish product</strong><p>Restores visibility when a valid priced offer includes this product.</p></div><form class="product-dashboard-action" action={`/api/creator/learning-products/${selectedProduct.id}/republish`}><button class="button button-small" type="submit">Republish</button><p class="form-message"></p></form></div>}</div>}</article>}
