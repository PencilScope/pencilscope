      </article>}

      {workspace === "creation" && section === "performance" && creatorOverview && <article class="panel dashboard-section-panel product-performance-panel"><div class="dashboard-section-heading"><div><span class="eyebrow">Product analytics</span><h2>Performance by product</h2><p>Compare learner access, engagement and completions across every format you create.</p></div><button class="button button-secondary button-small" type="button" data-export-performance>Export CSV</button></div><form class="performance-toolbar" method="get" action="/dashboard"><input type="hidden" name="workspace" value="creation" /><input type="hidden" name="section" value="performance" /><label>Period<select name="period"><option value="30" selected={requestedPeriod === "30"}>Last 30 days</option><option value="90" selected={requestedPeriod === "90"}>Last 90 days</option><option value="365" selected={requestedPeriod === "365"}>Last 12 months</option><option value="all" selected={requestedPeriod === "all"}>All time</option></select></label><label>Access<select name="scope"><option value="all" selected={requestedScope === "all"}>Owned and collaborating</option><option value="owned" selected={requestedScope === "owned"}>Owned by me</option><option value="collaborating" selected={requestedScope === "collaborating"}>Collaborating</option></select></label><label>Format<select name="type"><option value="all" selected={requestedType === "all"}>All products</option>{productTypes.map((type) => <option value={type} selected={requestedType === type}>{productLabels[type] ?? type.replaceAll("_", " ")}</option>)}</select></label><label>Status<select name="status"><option value="all" selected={requestedStatus === "all"}>All statuses</option><option value="published" selected={requestedStatus === "published"}>Published</option><option value="draft" selected={requestedStatus === "draft"}>Draft</option><option value="unpublished" selected={requestedStatus === "unpublished"}>Unpublished</option></select></label><label>Sort<select name="sort"><option value="learners" selected={requestedSort === "learners"}>Most learners</option><option value="completed" selected={requestedSort === "completed"}>Most completions</option><option value="completion" selected={requestedSort === "completion"}>Completion rate</option><option value="updated" selected={requestedSort === "updated"}>Recently updated</option></select></label><button class="button button-small" type="submit">Apply</button></form><p class="performance-context">Showing <strong>{visibleContent.length}</strong> products · {requestedPeriod === "all" ? "all-time learner activity" : `activity from the last ${requestedPeriod} days`}.</p>{performanceByType.length ? <div class="data-table-wrap"><table class="data-table product-breakdown-table" data-performance-table><thead><tr><th>Product type</th><th>Products</th><th>Published</th><th>Learners</th><th>Active</th><th>Completed</th><th>Completion</th><th>Assessment results</th></tr></thead><tbody>{performanceByType.map((group) => { const groupCompletion = group.learnerCount ? Math.round(group.completedCount / group.learnerCount * 100) : 0; const passRate = group.attemptCount ? Math.round(group.passedCount / group.attemptCount * 100) : 0; const averageScore = group.attemptCount ? Math.round(group.scoreTotal / group.attemptCount) : null; return <tr><td><strong>{productLabels[group.contentType] ?? group.contentType.replaceAll("_", " ")}</strong></td><td>{group.productCount}</td><td>{group.publishedCount}</td><td>{group.learnerCount}</td><td>{group.activeCount}</td><td>{group.completedCount}</td><td><strong>{groupCompletion}%</strong><progress value={groupCompletion} max="100"></progress></td><td>{group.attemptCount ? <><strong>{averageScore}% average</strong><small>{group.attemptCount} attempts · {passRate}% passed</small></> : <span class="muted-value">Not applicable</span>}</td></tr>; })}</tbody></table></div> : <p class="form-message">No products match these filters.</p>}</article>}

      {workspace === "creation" && section === "content" && creatorOverview && <article class="panel dashboard-section-panel content-manager-panel">
        <div class="dashboard-section-heading"><div><span class="eyebrow">Creator hub</span><h2>{requestedStatus === "all" ? "My content" : `${requestedStatus[0].toUpperCase()}${requestedStatus.slice(1)} content`}</h2><p>Drafts can be edited here. Published content uses versioned editing to protect enrolled learners.</p></div><span class="content-result-count">{visibleContent.length} shown</span></div>
        <form class="content-manager-toolbar" method="get" action="/dashboard"><input type="hidden" name="workspace" value="creation" /><input type="hidden" name="section" value="content" /><label><span>Search products</span><input type="search" name="q" value={requestedQuery} placeholder="Title, topic, audience or product ID" /></label><label><span>Format</span><select name="type"><option value="all">All formats</option>{Object.entries(productLabels).map(([value, label]) => <option value={value} selected={requestedType === value}>{label}</option>)}</select></label><label><span>Status</span><select name="status"><option value="all">All statuses</option><option value="draft" selected={requestedStatus === "draft"}>Draft</option><option value="published" selected={requestedStatus === "published"}>Published</option><option value="unpublished" selected={requestedStatus === "unpublished"}>Unpublished</option><option value="archived" selected={requestedStatus === "archived"}>Archived</option></select></label><button class="button button-small" type="submit">Find products</button></form>
        {visibleContent.length ? <div class="product-status-groups">{contentStatusGroups.filter((group) => requestedStatus === "all" || group.key === requestedStatus).map((group) => <section class:list={["product-status-group", group.key === "archived" && "archived"]}><header><div><span class:list={["status-group-mark", group.key]}></span><div><h3>{group.label}</h3><p>{group.description}</p></div></div><strong>{group.items.length}</strong></header>{group.items.length ? <div class="content-manager-list">{group.items.map((item) => {
