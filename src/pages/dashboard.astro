      {workspace === "learning" && section === "overview" && <>
        <div class="learning-metric-grid metric-link-grid">
          <a href="/dashboard?workspace=learning&section=learning&state=active"><strong>{activeCourseEnrolments.length}</strong><span>Active learning</span><small>Open in-progress courses</small></a>
          <a href="/dashboard?workspace=learning&section=learning"><strong>{averageProgress}%</strong><span>Average progress</span><small>Across enrolled courses</small></a>
