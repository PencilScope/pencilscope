---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ProductIcon from "@/components/ProductIcon.astro";
import LearningProductCard from "@/components/LearningProductCard.astro";
import CreateWithAI from "@/components/CreateWithAI.astro";
import { requestApi } from "@/lib/api-client";
import type { LearningProduct } from "@/lib/learning-products";
import { creatorProductCatalogue, productCatalogueKey, productDisplayLabel } from "@/lib/product-catalog";

const userId = await Astro.session?.get("userId");
if (typeof userId !== "string") return Astro.redirect("/sign-in");
const response = await requestApi("/api/dashboard", { userId });
if (response.status === 401) return Astro.redirect("/sign-in");
const data = await response.json<{
  user: {
    id: string; display_name: string; displayName?: string; role: string;
    account_type: "individual" | "organization"; organization_name: string | null;
  };
  students?: Array<{ id: string; display_name: string; primary_level: string | null }>;
  enrolments?: Array<{
    id: string;
    student_user_id: string;
    course_id: string;
    course_offering_id: string;
    offering_title: string;
    academic_year: number;
    term_number: number;
    status: string;
    title: string;
    subject: string;
    progress_percent: number;
  }>;
  creatorCourses?: Array<{
    id: string;
    slug: string;
    title: string;
    status: string;
    pricing_status: string;
    enrolment_count: number;
    listing_status: string;
    content_version: number;
  }>;
}>();
const requestedPeriod = ["30", "90", "365", "all"].includes(Astro.url.searchParams.get("period") ?? "")
  ? Astro.url.searchParams.get("period")! : "all";
const overviewResponse = await requestApi(`/api/creator/overview?period=${requestedPeriod}`, { userId });
const creatorOverview = overviewResponse.ok ? await overviewResponse.json<{
  period: string;
  metrics: {
    contentCount: number; moduleCount: number; lessonCount: number;
    subscribedCount: number; completedCount: number; inProgressCount: number;
  };
  commerce: Array<{
    currency: string; paymentCount: number; grossCents: number;
    refundCents: number; payableCents: number;
  }>;
  content: Array<{
    id: string; title: string; content_type: string; content_version: number;
    description: string; subject: string; audience: string; delivery_mode: string | null;
    content_url: string | null; estimated_minutes: number | null; can_edit: number;
    display_status: string; updated_at: string; subscribed_count: number;
    completed_count: number; in_progress_count: number;
    ownership_scope: "owned" | "collaborating"; member_role: string;
    attempt_count: number; average_score: number | null; passed_count: number;
  }>;
  auditLogs: Array<{
    id: string; action: string; entity_type: string; entity_id: string | null;
    metadata_json: string; created_at: string; actor_name: string;
  }>;
}>() : null;
const displayName = data.user.organization_name ?? data.user.displayName ?? data.user.display_name;
const error = Astro.url.searchParams.get("error");
const added = Astro.url.searchParams.get("added");
const enrolledCourseId = Astro.url.searchParams.get("enrolledCourse") ?? "";
const enrolledCourseSlug = Astro.url.searchParams.get("enrolledSlug") ?? "";
const workspace = Astro.url.searchParams.get("workspace") === "creation" ? "creation" : "learning";
const allowedSections = workspace === "creation"
  ? ["getting-started", "overview", "performance", "content", "product", "course-studio", "payments", "activity"]
  : ["overview", "learning", "results", "payments"];
const section = allowedSections.includes(Astro.url.searchParams.get("section") ?? "")
  ? Astro.url.searchParams.get("section")!
  : "overview";
const sectionTitles: Record<string, string> = {
  "getting-started": "Getting started",
  overview: workspace === "creation" ? "Creator Studio" : "Learning overview",
  learning: "My learning",
  results: "My results",
  performance: "Product performance",
  content: "My content",
  product: "Product dashboard",
  "course-studio": "Course studio",
  payments: workspace === "creation" ? "Creator payments" : "Payment history",
  activity: "Creation activity"
};
type CreatorPayment = {
  id: string; amount_cents: number; currency: string; status: string; created_at: string;
  course_title: string; offering_title: string | null; learner_name?: string; learner_email?: string;
  gross_cents?: number | null; processing_fee_cents?: number | null; platform_fee_cents?: number | null;
  meeting_usage_fee_cents?: number | null; refund_cents?: number | null; payable_cents?: number | null;
  settlement_status?: string | null; review_ends_at?: string | null; transferred_at?: string | null;
  issue_status?: string | null;
};
type CreatorPaymentSummary = {
  currency: string; gross_cents: number; deduction_cents: number;
  available_cents: number; transferred_cents: number; pending_cents: number;
};
let creatorPayments: { purchases: CreatorPayment[]; creatorSales: CreatorPayment[]; creatorSummary: CreatorPaymentSummary[] } = {
  purchases: [], creatorSales: [], creatorSummary: []
};
if (section === "payments") {
  const paymentsResponse = await requestApi("/api/payments", { userId });
  if (paymentsResponse.ok) creatorPayments = await paymentsResponse.json();
}
let learningProducts: LearningProduct[] = [];
if (workspace === "learning" && ["overview", "learning"].includes(section)) {
  const learningProductsResponse = await requestApi("/api/my-learning-products", { userId });
  if (learningProductsResponse.ok) {
    learningProducts = (await learningProductsResponse.json<{ products: LearningProduct[] }>()).products;
  }
}
type CourseAttempt = { id: string; title: string; assessment_type: string; course_title: string; status: string; started_at: string; submitted_at: string | null; score: number | null; passed: number | null };
type StandaloneAttempt = { id: string; title: string; product_type: string; score: number; passed: number; submitted_at: string };
let learningResults: { courseAttempts: CourseAttempt[]; standaloneAttempts: StandaloneAttempt[] } = {
  courseAttempts: [], standaloneAttempts: []
};
if (workspace === "learning" && section === "results") {
  const resultsResponse = await requestApi("/api/my-results", { userId });
  if (resultsResponse.ok) learningResults = await resultsResponse.json();
}
type InlineStudio = {
  course: { id: string; title: string; description: string; subject: string; primary_level: string; delivery_mode: string; status: string; listing_status: string; pricing_status: string };
  modules: Array<{ id: string; title: string }>;
  lessons: Array<{ id: string; module_id: string; title: string }>;
  offerings: Array<{ id: string; title: string; status: string; pricing_status: string; planned_meeting_minutes: number }>;
  sessions: Array<{ id: string; course_offering_id: string; title: string; delivery_mode: string; starts_at: string; ends_at: string; meeting_url: string | null; instructor_name: string | null }>;
};
const selectedCourseId = Astro.url.searchParams.get("courseId") ?? data.creatorCourses?.[0]?.id ?? "";
let inlineStudio: InlineStudio | null = null;
let inlineStudioError = "";
let studioTeam: Array<{ user_id: string; display_name: string; member_role: string; status: string }> = [];
if (workspace === "creation" && section === "course-studio" && selectedCourseId) {
  const studioResponse = await requestApi(`/api/tutor/courses/${encodeURIComponent(selectedCourseId)}/studio`, { userId });
  if (studioResponse.ok) inlineStudio = await studioResponse.json();
  else inlineStudioError = "This course could not be opened in Course Studio.";
  const teamResponse = await requestApi(`/api/tutor/courses/${encodeURIComponent(selectedCourseId)}/team`, { userId });
  if (teamResponse.ok) studioTeam = (await teamResponse.json<{ members: typeof studioTeam }>()).members;
}
const selectedStudioOfferingId = Astro.url.searchParams.get("offeringId") ?? inlineStudio?.offerings[0]?.id ?? "";
const selectedStudioOffering = inlineStudio?.offerings.find((offering) => offering.id === selectedStudioOfferingId);
const money = (amount: number | null | undefined, currency = "SGD") => new Intl.NumberFormat("en-SG", {
  style: "currency", currency
}).format(Number(amount ?? 0) / 100);
const settlementLabel = (value: string | null | undefined) => ({
  pending_course: "Course in progress", pending_usage: "Finalising class usage", review_period: "Learner review period",
  held: "On hold", eligible: "Ready for payout", payout_setup_required: "Payout setup required",
  transferring: "Sending payout", transferred: "Paid to creator", paid: "Paid to creator", zero_balance: "Settled",
  reversal_required: "Review required", reversed: "Reversed"
}[value ?? ""] ?? (value ?? "Not available").replaceAll("_", " "));
const enrolments = data.enrolments ?? [];
const newlyEnrolledCourse = enrolledCourseId
  ? enrolments.find((enrolment) => enrolment.course_id === enrolledCourseId) ?? null
  : null;
const requestedLearningFilter = ["all", "courses", "books", "media", "assessments"].includes(Astro.url.searchParams.get("kind") ?? "")
  ? Astro.url.searchParams.get("kind")! : "all";
const productMatchesLearningFilter = (product: LearningProduct) => requestedLearningFilter === "all"
  || (requestedLearningFilter === "books" && ["ebook", "audio"].includes(product.product_type))
  || (requestedLearningFilter === "media" && ["video", "reading"].includes(product.product_type))
  || (requestedLearningFilter === "assessments" && ["quiz", "test", "mock_exam"].includes(product.product_type));
const requestedLearningState = ["all", "active", "completed"].includes(Astro.url.searchParams.get("state") ?? "")
  ? Astro.url.searchParams.get("state")! : "all";
const completedCourseEnrolments = enrolments.filter((enrolment) => enrolment.status === "completed" || Number(enrolment.progress_percent) >= 100);
const activeCourseEnrolments = enrolments.filter((enrolment) => enrolment.status === "active" && Number(enrolment.progress_percent) < 100);
const visibleLearningProducts = requestedLearningFilter === "courses" || requestedLearningState === "completed" ? [] : learningProducts.filter(productMatchesLearningFilter);
const visibleCourseEnrolments = ["all", "courses"].includes(requestedLearningFilter) ? enrolments.filter((enrolment) => requestedLearningState === "all" || (requestedLearningState === "completed" ? completedCourseEnrolments.includes(enrolment) : activeCourseEnrolments.includes(enrolment))) : [];
const newlyEnrolledProducts = enrolledCourseSlug
  ? learningProducts.filter((product) => product.offer_course_slug === enrolledCourseSlug)
  : [];
const learningItemCount = enrolments.length + learningProducts.length;
const averageProgress = enrolments.length
  ? Math.round(enrolments.reduce((total, enrolment) => total + Number(enrolment.progress_percent), 0) / enrolments.length)
  : 0;
const completedLearning = completedCourseEnrolments.length;
const selectedLearningProductId = Astro.url.searchParams.get("learningProductId") ?? "";
const selectedLearningProduct = learningProducts.find((product) => product.id === selectedLearningProductId) ?? null;
const selectedLearningCourseId = Astro.url.searchParams.get("courseId") ?? "";
const selectedLearningEnrolment = enrolments.find((enrolment) => enrolment.course_id === selectedLearningCourseId) ?? null;
const selectedLearningStudentQuery = selectedLearningEnrolment && selectedLearningEnrolment.student_user_id !== data.user.id
  ? `?studentId=${encodeURIComponent(selectedLearningEnrolment.student_user_id)}` : "";
type InlineLearningCourse = {
  course: { id: string; title: string; description: string; subject: string; primary_level: string };
  modules: Array<{ id: string; title: string; position: number }>;
  lessons: Array<{ id: string; module_id: string; title: string; lesson_type: string; delivery_mode: string; content_json: string; estimated_minutes: number | null; progress_status: string; progress_percent: number }>;
  assessments: Array<{ id: string; lesson_id: string | null; assessment_type: string; title: string }>;
  flashcardDecks: Array<{ id: string; lesson_id: string | null; title: string }>;
  sessions: Array<{ id: string; title: string; delivery_mode: string; starts_at: string; ends_at: string; timezone: string; meeting_url: string | null; venue_name: string | null; address_line_1: string | null; postal_code: string | null }>;
};
let inlineLearningCourse: InlineLearningCourse | null = null;
if (workspace === "learning" && section === "learning" && selectedLearningEnrolment) {
  const learningResponse = await requestApi(`/api/learning/courses/${encodeURIComponent(selectedLearningEnrolment.course_id)}${selectedLearningStudentQuery}`, { userId });
  if (learningResponse.ok) inlineLearningCourse = await learningResponse.json<InlineLearningCourse>();
}
const requestedScope = ["all", "owned", "collaborating"].includes(Astro.url.searchParams.get("scope") ?? "")
  ? Astro.url.searchParams.get("scope")! : "all";
const requestedStatus = ["all", "draft", "published", "unpublished", "archived"].includes(Astro.url.searchParams.get("status") ?? "")
  ? Astro.url.searchParams.get("status")! : "all";
const requestedType = Astro.url.searchParams.get("type") ?? "all";
const requestedBooked = Astro.url.searchParams.get("booked") === "yes";
const requestedQuery = (Astro.url.searchParams.get("q") ?? "").trim().slice(0, 120);
const requestedSort = ["learners", "completed", "completion", "updated"].includes(Astro.url.searchParams.get("sort") ?? "")
  ? Astro.url.searchParams.get("sort")! : section === "content" ? "updated" : "learners";
const productLabels: Record<string, string> = {
  course: "Courses", ebook: "Ebooks", reading: "Reading materials", quiz: "Quizzes",
  test: "Tests", mock_exam: "Mock exams", video: "Videos", audio: "Audio books"
};
const creationOptions = creatorProductCatalogue;
const displayProductLabel = (item: { content_type: string; delivery_mode?: string | null }) =>
  productDisplayLabel(item.content_type, item.delivery_mode);
const statusCounts = creatorOverview?.content.reduce((counts, item) => {
  counts.all += 1;
  if (["draft", "published", "unpublished", "archived"].includes(item.display_status)) {
    counts[item.display_status] += 1;
  }
  return counts;
}, { all: 0, draft: 0, published: 0, unpublished: 0, archived: 0 } as Record<string, number>) ?? { all: 0, draft: 0, published: 0, unpublished: 0, archived: 0 };
const productsWithBookings = creatorOverview?.content.filter((item) => Number(item.subscribed_count) > 0) ?? [];
const bookingChartProducts = [...productsWithBookings].sort((left, right) => Number(right.subscribed_count) - Number(left.subscribed_count)).slice(0, 5);
const maxProductBookings = Math.max(1, ...bookingChartProducts.map((item) => Number(item.subscribed_count)));
const productTypes = creatorOverview
  ? [...new Set(creatorOverview.content.map((item) => item.content_type))]
    .sort((left, right) => Object.keys(productLabels).indexOf(left) - Object.keys(productLabels).indexOf(right))
  : [];
const visibleContent = creatorOverview ? creatorOverview.content.filter((item) =>
  (requestedScope === "all" || item.ownership_scope === requestedScope) &&
  (requestedStatus === "all" || item.display_status === requestedStatus) &&
  (requestedType === "all" || item.content_type === requestedType) &&
  (!requestedBooked || Number(item.subscribed_count) > 0) &&
  (!requestedQuery || `${item.id} ${item.title} ${item.subject} ${item.audience}`.toLowerCase().includes(requestedQuery.toLowerCase()))
) : [];
const completionRate = (item: { subscribed_count: number; completed_count: number }) =>
  Number(item.subscribed_count) > 0 ? Math.round(Number(item.completed_count) / Number(item.subscribed_count) * 100) : 0;
visibleContent.sort((left, right) => requestedSort === "updated"
  ? right.updated_at.localeCompare(left.updated_at)
  : requestedSort === "completed"
    ? Number(right.completed_count) - Number(left.completed_count)
    : requestedSort === "completion"
      ? completionRate(right) - completionRate(left)
      : Number(right.subscribed_count) - Number(left.subscribed_count));
const contentStatusGroups = [
  { key: "draft", label: "Drafts", description: "Work in progress that only you and your collaborators can see." },
  { key: "published", label: "Published", description: "Live products that can be included in priced offers." },
  { key: "unpublished", label: "Unpublished", description: "Products removed from new enrolment while learner records stay protected." },
  { key: "archived", label: "Archived", description: "Inactive products retained for records and audit history." }
].map((group) => ({ ...group, items: visibleContent.filter((item) => item.display_status === group.key) }));
const requestedGettingStartedProduct = Astro.url.searchParams.get("product") ?? "";
const gettingStartedProduct = creatorProductCatalogue.find((item) => item.key === requestedGettingStartedProduct) ?? null;
const requestedGettingStartedStep = Number(Astro.url.searchParams.get("step") ?? (gettingStartedProduct ? "2" : "1"));
const gettingStartedStep = Math.min(5, Math.max(1, Number.isFinite(requestedGettingStartedStep) ? requestedGettingStartedStep : 1));
const gettingStartedSteps = ["Choose product", "Create draft", "Build content", "Price & access", "Review & publish"];
const gettingStartedDrafts = creatorOverview?.content.filter((item) => item.display_status === "draft").slice(0, 5) ?? [];
const performanceByType = [...visibleContent.reduce((groups, item) => {
  const current = groups.get(item.content_type) ?? {
    contentType: item.content_type, productCount: 0, publishedCount: 0, learnerCount: 0,
    activeCount: 0, completedCount: 0, attemptCount: 0, passedCount: 0, scoreTotal: 0
  };
  current.productCount += 1;
  current.publishedCount += item.display_status === "published" ? 1 : 0;
  current.learnerCount += Number(item.subscribed_count);
  current.activeCount += Number(item.in_progress_count);
  current.completedCount += Number(item.completed_count);
  current.attemptCount += Number(item.attempt_count ?? 0);
  current.passedCount += Number(item.passed_count ?? 0);
  current.scoreTotal += Number(item.average_score ?? 0) * Number(item.attempt_count ?? 0);
  groups.set(item.content_type, current);
  return groups;
}, new Map<string, {
  contentType: string; productCount: number; publishedCount: number; learnerCount: number;
  activeCount: number; completedCount: number; attemptCount: number; passedCount: number; scoreTotal: number;
}>()).values()].sort((left, right) => right.learnerCount - left.learnerCount);
const selectedProductId = Astro.url.searchParams.get("productId") ?? "";
const selectedProduct = creatorOverview?.content.find((item) => item.id === selectedProductId) ?? null;
const productTabs = ["overview", "learners", "performance", "offers", "versions", "activity", "settings"] as const;
const requestedProductTab = Astro.url.searchParams.get("tab") ?? "overview";
const productTab = productTabs.includes(requestedProductTab as typeof productTabs[number])
  ? requestedProductTab as typeof productTabs[number] : "overview";
let selectedProductDetail: LearningProduct | null = null;
if (workspace === "creation" && section === "product" && selectedProduct && selectedProduct.content_type !== "course") {
  const productsResponse = await requestApi("/api/creator/learning-products", { userId });
  if (productsResponse.ok) {
    selectedProductDetail = (await productsResponse.json<{ products: LearningProduct[] }>()).products
      .find((product) => product.id === selectedProduct.id) ?? null;
  }
}
const productDashboardUrl = (tab: typeof productTabs[number]) =>
  `/dashboard?workspace=creation&section=product&productId=${encodeURIComponent(selectedProductId)}&tab=${tab}`;
const selectedCompletionRate = selectedProduct ? completionRate(selectedProduct) : 0;
const selectedPassRate = selectedProduct && Number(selectedProduct.attempt_count) > 0
  ? Math.round(Number(selectedProduct.passed_count) / Number(selectedProduct.attempt_count) * 100) : 0;
const selectedProductActivity = creatorOverview?.auditLogs.filter((entry) => entry.entity_id === selectedProductId).slice(0, 20) ?? [];
const isAssessmentDashboard = selectedProduct ? ["quiz", "test", "mock_exam"].includes(selectedProduct.content_type) : false;
const selectedCourseRecord = data.creatorCourses?.find((course) => course.id === selectedProductId) ?? null;
const selectedContentReady = selectedProduct?.content_type === "course"
  ? selectedProduct.display_status !== "draft"
  : isAssessmentDashboard
    ? Number(selectedProductDetail?.question_count ?? 0) > 0
    : Boolean(selectedProductDetail?.content_url);
const selectedOfferReady = selectedProduct?.content_type === "course"
  ? selectedCourseRecord?.pricing_status === "ready"
  : Boolean(selectedProductDetail?.offer_title);
const selectedJourneyLabels = selectedProduct?.content_type === "course"
  ? selectedProduct.delivery_mode === "live" ? ["Learning promise", "Curriculum", "Online sessions", "Price & enrolment", "Publish"]
    : selectedProduct.delivery_mode === "hybrid" ? ["Learning promise", "Curriculum", "Venue & schedule", "Price & enrolment", "Publish"]
      : ["Learning promise", "Modules & media", "Learner preview", "Price & enrolment", "Publish"]
  : selectedProduct?.content_type === "ebook" ? ["Book details", "Chapters", "Reader preview", "Price & enrolment", "Publish"]
    : selectedProduct?.content_type === "audio" ? ["Book details", "Audio content", "Listening preview", "Price & enrolment", "Publish"]
      : selectedProduct?.content_type === "video" ? ["Learning promise", "Video content", "Playback preview", "Price & enrolment", "Publish"]
        : isAssessmentDashboard ? ["Assessment details", "Questions", "Attempt preview", "Price & enrolment", "Publish"]
          : ["Product details", "Content", "Learner preview", "Price & enrolment", "Publish"];
const selectedJourneyComplete = [Boolean(selectedProduct), selectedContentReady, selectedContentReady, selectedOfferReady, selectedProduct?.display_status === "published"];
const selectedJourneyCurrent = selectedJourneyComplete.findIndex((complete) => !complete);
const selectedEditorUrl = selectedProduct?.content_type === "course"
  ? `/dashboard?workspace=creation&section=course-studio&courseId=${encodeURIComponent(selectedProductId)}${selectedProduct?.display_status === "draft" ? "&edit=details" : ""}`
  : `/create?edit=${encodeURIComponent(selectedProductId)}#create-product`;
const selectedPublicUrl = selectedProduct?.content_type === "course"
  ? selectedCourseRecord?.slug ? `/courses/${selectedCourseRecord.slug}` : null
  : selectedProductDetail?.slug ? `/library/${selectedProductDetail.slug}` : null;
const productPortfolio = [
  { key: "course", label: "Courses", types: ["course"] },
  { key: "assessment", label: "Assessments", types: ["quiz", "test", "mock_exam"] },
  { key: "reading", label: "Ebooks & reading", types: ["ebook", "reading"] },
  { key: "media", label: "Video & audio books", types: ["video", "audio"] }
].map((group) => {
  const products = creatorOverview?.content.filter((item) => group.types.includes(item.content_type)) ?? [];
  return {
    ...group,
    products: products.length,
    published: products.filter((item) => item.display_status === "published").length,
    learners: products.reduce((total, item) => total + Number(item.subscribed_count), 0),
    completed: products.reduce((total, item) => total + Number(item.completed_count), 0)
  };
});
const pageTitle = section === "product" && selectedProduct ? selectedProduct.title : sectionTitles[section];
---
<BaseLayout title={`${pageTitle} — PencilScope`}>
  <section class="dashboard-hero dashboard-hero-compact"><div class="shell dashboard-hero-row"><div><span class="eyebrow">{section === "product" ? "Product dashboard" : "Your PencilScope"}</span><h1>{pageTitle}</h1><p>{section === "product" && selectedProduct ? `${displayProductLabel(selectedProduct)} · ID ${selectedProduct.id} · version ${selectedProduct.content_version ?? 1} · ${selectedProduct.display_status}` : `Welcome, ${displayName}. ${workspace === "learning" ? "Continue where you left off." : "Build, manage and measure your learning products."}`}</p></div>{workspace === "creation" && <div class="dashboard-hero-actions"><CreateWithAI compact /><details class="create-product-menu"><summary class="button button-small">+ Create product <span aria-hidden="true">⌄</span></summary><div class="create-product-popover">{creationOptions.map((option) => <a href={option.href}><ProductIcon name={option.key} size="small" /><span><strong>{option.label}</strong><small>{option.shortDescription}</small></span></a>)}</div></details></div>}</div></section>
  <section class="shell workspace-dashboard-layout">
    <aside class="panel dashboard-sidebar">
      <div class="dashboard-nav-group"><span>{workspace === "learning" ? "Learning workspace" : "Creator Studio"}</span><nav class="dashboard-side-links" aria-label={`${workspace} workspace sections`}>{workspace === "learning" ? <><a class:list={{ active: section === "overview" }} aria-current={section === "overview" ? "page" : undefined} href="/dashboard?workspace=learning&section=overview">Home</a><a class:list={{ active: section === "learning" }} aria-current={section === "learning" ? "page" : undefined} href="/dashboard?workspace=learning&section=learning">My learning</a><a class:list={{ active: section === "results" }} aria-current={section === "results" ? "page" : undefined} href="/dashboard?workspace=learning&section=results">Results</a><a class:list={{ active: section === "payments" }} aria-current={section === "payments" ? "page" : undefined} href="/dashboard?workspace=learning&section=payments">Purchases</a><a href="/library">Explore</a></> : <><a class:list={{ active: section === "overview" || section === "getting-started" }} aria-current={section === "overview" ? "page" : undefined} href="/dashboard?workspace=creation&section=overview">Home</a><a class:list={{ active: section === "content" || section === "product" || section === "course-studio" }} aria-current={section === "content" ? "page" : undefined} href="/dashboard?workspace=creation&section=content">Products <b>{statusCounts.all}</b></a><a href="/network?section=learners">Learners</a><a class:list={{ active: section === "payments" }} aria-current={section === "payments" ? "page" : undefined} href="/dashboard?workspace=creation&section=payments">Sales</a><a href="/content-library">Content Library</a><a class:list={{ active: section === "activity" }} aria-current={section === "activity" ? "page" : undefined} href="/dashboard?workspace=creation&section=activity">Activity</a><a href="/profile">Settings</a></>}</nav></div>
    </aside>
    <main class="dashboard-content">
      {error && <p class="form-error dashboard-message" role="alert">{error}</p>}{added && <p class="form-success dashboard-message">Learner profile created.</p>}
