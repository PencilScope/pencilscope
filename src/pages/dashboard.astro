          return <article class="content-manager-item">
            <header><ProductIcon name={productCatalogueKey(item.content_type, item.delivery_mode)} /><div class="content-manager-title"><span class:list={["performance-status", item.display_status]}>{item.display_status}</span><a class="content-title-link" href={`/dashboard?workspace=creation&section=product&productId=${item.id}`}><strong>{item.title}</strong></a><small>{displayProductLabel(item)} · version {item.content_version ?? 1} · {item.ownership_scope === "owned" ? "Owned by me" : `Collaborating as ${item.member_role.replace("instructor", "co-host")}`}</small><code class="product-id">ID {item.id}</code></div><div class="content-manager-stats"><span><strong>{item.subscribed_count}</strong> enrolled</span><span><strong>{item.completed_count}</strong> completed</span><span><strong>{rate}%</strong> completion</span></div><div class="content-manager-actions"><a class="button button-small button-secondary" href={`/dashboard?workspace=creation&section=product&productId=${item.id}`}>Dashboard</a>{item.display_status === "draft" && Boolean(item.can_edit) ? <details class="inline-draft-editor"><summary class="text-link">Quick edit</summary><div class="inline-editor-popover"><form class="dashboard-draft-form" data-kind={isCourse ? "course" : "product"} action={isCourse ? `/api/tutor/courses/${item.id}` : `/api/creator/learning-products/${item.id}`}><input type="hidden" name="productType" value={item.content_type} /><div class="inline-editor-grid"><label>Title<input name="title" required minlength="3" maxlength="160" value={item.title} /></label><label>Topic<input name="subject" required maxlength="120" value={item.subject ?? ""} /></label><label>Audience<input name={isCourse ? "primaryLevel" : "audience"} required maxlength="120" value={item.audience ?? ""} /></label>{isCourse ? <label>Delivery<select name="deliveryMode" required><option value="self-paced" selected={item.delivery_mode === "self-paced"}>Self-paced</option><option value="live" selected={item.delivery_mode