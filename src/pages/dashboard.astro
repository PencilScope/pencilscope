---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { requestApi } from "@/lib/api-client";

const userId = await Astro.session?.get("userId");
if (typeof userId !== "string") return Astro.redirect("/sign-in");
const response = await requestApi("/api/dashboard", { userId });
if (response.status === 401) return Astro.redirect("/sign-in");
const data = await response.json<{
  user: {
    id: string; display_name: string; displayName?: string; role: string;
    account_type: "individual" | "organization"; organization_name: string | null;
  };
  students?: Array<{ id: string; display_name: string; primary_level: string | null }>;
  enrolments?: Array<{
    id: string;
    student_user_id: string;
    course_id: string;
    course_offering_id: string;
    offering_title: string;
    academic_year: number;
    term_number: number;
    status: string;
    title: string;
    subject: string;
    progress_percent: number;
  }>;
  creatorCourses?: Array<{
    id: string;
    slug: string;
    title: string;
    status: string;
    pricing_status: string;
    enrolment_count: number;
  }>;
}>();
const displayName = data.user.organization_name ?? data.user.displayName ?? data.user.display_name;
const error = Astro.url.searchParams.get("error");
const added = Astro.url.searchParams.get("added");
---
<BaseLayout title="Dashboard — PencilScope">
  <section class="dashboard-hero">
    <div class="shell">
      <span class="eyebrow">Your PencilScope</span>
      <h1>Welcome, {displayName}.</h1>
      <p>Continue learning, support your learners, or shape the next great course.</p>
    </div>
  </section>
  <section class="shell dashboard-grid">
    {error && <p class="form-error dashboard-message" role="alert">{error}</p>}
    {added && <p class="form-success dashboard-message">Learner profile created.</p>}

    {data.user.account_type === "individual" && data.user.role !== "student" && (
        <article class="panel">
          <span class="eyebrow">Linked learners</span>
          <h2>People you support</h2>
          {data.students?.length ? (
            <div class="learner-list">
              {data.students.map((student) => (
                <div><span class="tutor-avatar">{student.display_name.slice(0, 1)}</span><p><strong>{student.display_name}</strong><small>{student.primary_level}</small></p></div>
              ))}
            </div>
          ) : <p>You can enrol yourself now, or add a learner you manage.</p>}
          <form class="stack-form compact-form" action="/api/students" method="post">
            <label>Learner name<input name="displayName" required minlength="2" /></label>
            <label>Learning stage<input name="primaryLevel" required minlength="2" maxlength="40" placeholder="Beginner, Primary 5, professional…" /></label>
            <button class="button" type="submit">Add learner</button>
          </form>
        </article>
    )}

    {data.user.account_type === "individual" && (
      <article class="panel panel-wide">
        <span class="eyebrow">Course access</span><h2>Active learning</h2>
        {data.enrolments?.length ? <div class="dashboard-courses">{data.enrolments.map((enrolment) => {
          const learnerQuery = enrolment.student_user_id === data.user.id
            ? "" : `?studentId=${encodeURIComponent(enrolment.student_user_id)}`;
          return <a href={`/learn/${enrolment.course_id}${learnerQuery}`}><span>{enrolment.subject} · {enrolment.offering_title}</span><strong>{enrolment.title}</strong><small>{Math.round(enrolment.progress_percent)}% complete · {enrolment.status}</small></a>;
        })}</div> : <p>No active enrolments yet. <a class="text-link" href="/courses">Explore courses</a></p>}
      </article>
    )}

    <article class="panel panel-wide">
        <span class="eyebrow">Creator studio</span><h2>Create and manage courses</h2>
        {data.creatorCourses?.length ? <div class="dashboard-courses">{data.creatorCourses.map((course) => (
          <a href={`/tutor?courseId=${course.id}`}><span>{course.status} · {course.pricing_status}</span><strong>{course.title}</strong><small>{course.enrolment_count} learners</small></a>
        ))}</div> : <p>Share a skill, run a seminar, teach a class, or publish a self-paced course.</p>}
        <a class="button" href="/tutor">Open creator studio</a>
      </article>
  </section>
</BaseLayout>
