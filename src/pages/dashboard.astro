        <ol class="creator-stepper" aria-label="Product creation progress">{gettingStartedSteps.map((label, index) => <li class:list={{ active: gettingStartedStep === index + 1, complete: gettingStartedStep > index + 1 }}><span>{gettingStartedStep > index + 1 ? "✓" : index + 1}</span><strong>{label}</strong></li>)}</ol>
        {gettingStartedStep === 1 && <form class="getting-started-form" method="get" action="/dashboard"><input type="hidden" name="workspace" value="creation" /><input type="hidden" name="section" value="getting-started" /><input type="hidden" name="step" value="2" /><fieldset><legend>What do you want to create?</legend><div class="getting-started-product-grid">{creationOptions.map((option) => <label><input type="radio" name="product" value={option.key} required /><span class="getting-started-product-card"><ProductIcon name={option.key} /><strong>{option.label}</strong><small>{option.shortDescription}</small></span></label>)}</div></fieldset><div class="getting-started-actions"><button class="button" type="submit">Continue</button></div></form>}
        {gettingStartedStep === 2 && gettingStartedProduct && <section class="getting-started-stage"><div class="getting-started-stage-heading"><ProductIcon name={gettingStartedProduct.key} /><div><span class="eyebrow">Step 2 of 5</span><h3>Create your {gettingStartedProduct.label.toLowerCase()} draft</h3><p>Your draft stays private. You can leave and resume it from All products at any time.</p></div></div>{["online_course", "in_person_course", "video_course"].includes(gettingStartedProduct.key) ? <form class="inline-studio-form dashboard-api-form" data-kind="course" action="/api/tutor/courses"><div class="inline-editor-grid"><label>Title<input name="title" required minlength="3" placeholder="A clear learner-focused title" /></label><label>Topic<input name="subject" required placeholder="Mathematics, leadership, design…" /></label><label>Audience<input name="primaryLevel" required placeholder="Beginners, Secondary 4, managers…" /></label><label>Category<select name="categorySlug"><option value="academic">Academic</option><option value="enrichment">Enrichment</option><option value="personal-development">Personal development</option><option value="professional-development">Professional development</option><option value="masterclass">Masterclass</option><option value="knowledge-sharing">Knowledge sharing</option></select></label></div><input type="hidden" name="deliveryMode" value={gettingStartedProduct.key === "online_course" ? "live" : gettingStartedProduct.key === "in_person_course" ? "hybrid" : "self-paced"} /><label>Description<textarea name="description" required minlength="20" rows="4" placeholder="Explain what learners will achieve."></textarea></label><p class="meet-assurance"><strong>Draft first:</strong> Add content now. Pricing and publication are completed later, after the learner experience is ready.</p><button class="button" type="submit">Save draft and build content</button><p class="form-message" aria-live="polite"></p></form> : <div class="specialist-editor-card"><div><strong>Open the {gettingStartedProduct.label} editor</strong><p>This format has a purpose-built editor for chapters, media links or multiple assessment questions.</p></div><a class="button" href={gettingStartedProduct.href}>Create draft</a></div>}<nav class="getting-started-actions"><a class="button button-secondary" href="/dashboard?workspace=creation&section=getting-started">Back</a></nav></section>}
        {gettingStartedStep >= 3 && gettingStartedProduct && <section class="getting-started-stage"><div class="getting-started-stage-heading"><ProductIcon name={gettingStartedProduct.key} /><div><span class="eyebrow">Step {gettingStartedStep} of 5</span><h3>{gettingStartedSteps[gettingStartedStep - 1]}</h3><p>{gettingStartedStep === 3 ? "Add the complete learner experience in the product editor." : gettingStartedStep === 4 ? "Set learner pricing and include the product in an offer. Nothing is visible to other users before the offer is priced and published." : "Preview the learner experience, check access and publish when it is ready."}</p></div></div><div class="getting-started-checklist">{gettingStartedStep === 3 ? <><span>✓ Add lessons, chapters, media or questions</span><span>✓ Check the learner overview</span><span>✓ Save changes to the draft</span></> : gettingStartedStep === 4 ? <><span>✓ Set a learner price</span><span>✓ Confirm platform and online meeting costs</span><span>✓ Choose who can enrol</span></> : <><span>✓ Preview the complete product</span><span>✓ Confirm content and pricing readiness</span><span>✓ Publish the product and its offer</span></>}</div><nav class="getting-started-actions"><a class="button button-secondary" href={`/dashboard?workspace=creation&section=getting-started&product=${gettingStartedProduct.key}&step=${gettingStartedStep - 1}`}>Back</a><a class="button button-secondary" href={gettingStartedStep === 3 ? gettingStartedProduct.href : "/dashboard?workspace=creation&section=content&status=draft"}>{gettingStartedStep === 3 ? "Open product editor" : "Open drafts"}</a>{gettingStartedStep < 5 ? <a class="button" href={`/dashboard?workspace=creation&section=getting-started&product=${gettingStartedProduct.key}&step=${gettingStartedStep + 1}`}>Continue</a> : <a class="button" href="/dashboard?workspace=creation&section=content">View all products</a>}</nav></section>}
        {gettingStartedDrafts.length > 0 && <section class="getting-started-resume"><div><span class="eyebrow">Continue working</span><h3>Recent drafts</h3></div><div>{gettingStartedDrafts.map((item) => <a href={`/dashboard?workspace=creation&section=product&productId=${item.id}`}><ProductIcon name={productCatalogueKey(item.content_type, item.delivery_mode)} size="small" /><span><strong>{item.title}</strong><small>{displayProductLabel(item)} · ID {item.id}</small></span><b>Resume →</b></a>)}</div></section>}
      </article>}
      {workspace === "creation" && section === "overview" && <article class="panel dashboard-section-panel creation-summary">
        <div class="dashboard-section-heading"><div><span class="eyebrow">Creation overview</span><h2>Your content at a glance</h2></div><a class="text-link" href="/dashboard?workspace=creation&section=performance">View performance →</a></div>
        {creatorOverview && <>
