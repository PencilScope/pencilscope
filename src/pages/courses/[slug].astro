---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { findCourseBySlug, requestApi } from "@/lib/api-client";
import { formatPrice } from "@/lib/courses";
const course = await findCourseBySlug(Astro.params.slug ?? "");
if (!course) return Astro.redirect("/404");
const userId = await Astro.session?.get("userId");
let viewer: {
  role: string;
  students: Array<{ id: string; display_name: string; primary_level: string | null }>;
} | null = null;
if (typeof userId === "string") {
  const dashboard = await requestApi("/api/dashboard", { userId });
  if (dashboard.ok) {
    const data = await dashboard.json<{
      user: { role: string };
      students?: Array<{ id: string; display_name: string; primary_level: string | null }>;
    }>();
    viewer = { role: data.user.role, students: data.students ?? [] };
  }
}
const checkoutMessage = Astro.url.searchParams.get("error");
const checkoutSuccess = Astro.url.searchParams.get("checkout") === "success";
---

<BaseLayout title={`${course.title} — PencilScope`} description={course.description}>
  <section class="course-detail-hero">
    <div class="shell detail-grid">
      <div><a class="back-link" href="/courses">← All courses</a><div class="detail-tags"><span>{course.subject}</span><span>{course.level}</span><span>{course.deliveryMode}</span></div><h1>{course.title}</h1><p>{course.description}</p><div class="tutor-line"><span class="tutor-avatar">{course.tutorName.split(" ").at(-1)?.slice(0, 1)}</span><span>Designed and taught by <strong>{course.tutorName}</strong></span></div></div>
      <aside class="enrol-card"><div class={`enrol-art accent-${course.accent}`}><span>{course.subject.slice(0, 1)}</span></div><div class="enrol-body"><span class="price-label">Course access</span><strong class="detail-price">{formatPrice(course.priceCents, course.currency)}</strong><ul><li>Structured video lessons</li><li>Guided quizzes and practice</li><li>Progress visible to parents</li><li>Certificate when completed</li></ul>
        {checkoutMessage && <p class="form-error">{checkoutMessage}</p>}
        {checkoutSuccess && <p class="form-success">Payment received. Course access will appear on your dashboard as soon as Stripe confirms it.</p>}
        {!viewer && <a class="button button-full" href={`/sign-in?next=/courses/${course.slug}`}>Sign in to enrol</a>}
        {viewer?.role === "parent" && viewer.students.length === 0 && <><p>Add a learner profile before enrolling.</p><a class="button button-full" href="/dashboard">Add learner</a></>}
        {viewer && (viewer.role === "student" || (viewer.role === "parent" && viewer.students.length > 0)) && <form class="stack-form checkout-form" action="/api/checkout" method="post">
          <input type="hidden" name="courseId" value={course.id} /><input type="hidden" name="returnTo" value={`/courses/${course.slug}`} />
          {viewer.role === "parent" && <label>Enrol learner<select name="studentId" required><option value="">Choose a learner</option>{viewer.students.map((student) => <option value={student.id}>{student.display_name} · {student.primary_level}</option>)}</select></label>}
          <button class="button button-full" type="submit">Continue to secure checkout</button>
        </form>}
        {viewer && !["parent", "student"].includes(viewer.role) && <p class="form-message">Course purchases are available to parent and student accounts.</p>}
        <small>Secure checkout powered by Stripe</small></div></aside>
    </div>
  </section>
  <section class="shell detail-content"><article><span class="eyebrow">What they’ll learn</span><h2>Confidence, one clear step at a time</h2><p>This starter course page is connected to the course catalogue and commerce API. Lesson plans, tutor previews and outcomes will be loaded from D1 as the authoring workflow is implemented.</p></article><aside><strong>Built for young learners</strong><p>Short sessions, accessible design and parent-guided access are part of every PencilScope learning path.</p></aside></section>
</BaseLayout>
