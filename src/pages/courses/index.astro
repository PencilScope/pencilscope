---
import CourseCard from "@/components/CourseCard.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { listPublishedCourses } from "@/lib/api-client";
const courses = await listPublishedCourses();
---

<BaseLayout title="Explore courses — PencilScope" description="Explore courses, workshops, seminars and masterclasses for every kind of learner.">
  <section class="page-hero shell"><span class="eyebrow">Explore learning</span><h1>Learn something <em>worth sharing.</em></h1><p>Discover self-paced courses, live cohorts, workshops, seminars and in-person experiences created by people with knowledge to share.</p></section>
  <section class="shell catalogue-section">
    <div class="filter-bar" aria-label="Course categories"><span class="filter active">All learning</span><span class="filter">Academic</span><span class="filter">Enrichment</span><span class="filter">Masterclasses</span><span class="filter">Seminars</span><span class="result-count">{courses.length} courses</span></div>
    <div class="course-grid">{courses.map((course) => <CourseCard course={course} />)}</div>
  </section>
</BaseLayout>
