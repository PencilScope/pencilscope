---
import OfferCard from "@/components/OfferCard.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { listPublishedOffers } from "@/lib/api-client";
const query = Astro.url.searchParams.get("q")?.trim().slice(0, 100) ?? "";
const offers = await listPublishedOffers({ q: query, type: "course" });
---

<BaseLayout title="Explore courses — PencilScope" description="Explore expert-led online, in-person and self-paced courses.">
  <section class="catalogue-hero"><div class="shell catalogue-hero-inner"><div><span class="eyebrow">Courses</span><h1>Find your next course.</h1><p>Compare expert-led courses and course bundles, with price and availability shown upfront.</p></div><form class="catalogue-search" action="/courses" method="get" role="search"><label class="sr-only" for="course-catalogue-search">Search courses</label><span aria-hidden="true">⌕</span><input id="course-catalogue-search" name="q" type="search" value={query} placeholder="Search by topic, skill or expert…" /><button class="button button-small" type="submit">Search</button></form></div></section>
  <section class="shell catalogue-section compact-catalogue"><nav class="catalogue-filters" aria-label="Explore learning"><a class="filter active" href="/courses">Courses</a><a class="filter" href="/offers?kind=bundle">Bundles</a><a class="filter" href="/offers?kind=independent">Single resources</a><a class="filter" href="/offers">All learning</a></nav><div class="catalogue-summary"><p><strong>{offers.length}</strong> available {offers.length === 1 ? "course" : "courses"}</p>{query && <a class="text-link" href="/courses">Clear search</a>}</div>{offers.length ? <div class="offer-grid">{offers.map((offer) => <OfferCard offer={offer} compact />)}</div> : <div class="panel catalogue-empty"><span aria-hidden="true">⌕</span><h2>No courses found</h2><p>Try a broader topic or explore all learning.</p><a class="button button-secondary" href="/offers">Explore all learning</a></div>}</section>
</BaseLayout>
