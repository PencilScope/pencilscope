---
import BaseLayout from "@/layouts/BaseLayout.astro";
const error = Astro.url.searchParams.get("error");
---
<BaseLayout title="Create an account — PencilScope">
  <section class="auth-shell shell">
    <div class="auth-card">
      <span class="eyebrow">Join PencilScope</span>
      <h1>Create your account</h1>
      <p>Individuals can learn, manage linked learners and create courses. Organisations can publish training under their organisation name.</p>
      {error && <p class="form-error" role="alert">{error}</p>}
      <form class="stack-form" action="/api/auth/register" method="post">
        <label>Full name<input name="displayName" required minlength="2" maxlength="80" autocomplete="name" /></label>
        <label>Email<input name="email" required type="email" autocomplete="email" /></label>
        <label>Password<input name="password" required type="password" minlength="10" autocomplete="new-password" /></label>
        <label>Account type<select name="accountType" id="account-type"><option value="individual">Individual</option><option value="organization">Organisation</option></select></label>
        <label id="organization-field" hidden>Organisation name<input name="organizationName" id="organization-name" minlength="2" maxlength="160" autocomplete="organization" /></label>
        <button class="button button-full" type="submit">Create account</button>
      </form>
      <a class="text-link" href="/sign-in">Already registered? Sign in</a>
    </div>
  </section>
  <script>
    const accountType = document.getElementById("account-type") as HTMLSelectElement | null;
    const organizationField = document.getElementById("organization-field");
    const organizationName = document.getElementById("organization-name") as HTMLInputElement | null;
    const updateAccountFields = () => {
      const organization = accountType?.value === "organization";
      if (organizationField) organizationField.hidden = !organization;
      if (organizationName) organizationName.required = organization;
    };
    accountType?.addEventListener("change", updateAccountFields);
    updateAccountFields();
  </script>
</BaseLayout>
