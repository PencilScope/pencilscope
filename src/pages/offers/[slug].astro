---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ProductIcon from "@/components/ProductIcon.astro";
import { findPublishedOffer } from "@/lib/api-client";
import { offerAvailabilityLabel, offerPrice } from "@/lib/offers";
import type { ProductIconName } from "@/lib/product-catalog";

const slug = Astro.params.slug ?? "";
const result = await findPublishedOffer(slug);
if (!result) return Astro.redirect("/offers", 302);
const { offer, items } = result;
const userId = await Astro.session?.get("userId");
const signedIn = typeof userId === "string";
const checkoutSuccess = Astro.url.searchParams.get("checkout") === "success";
const checkoutSessionId = Astro.url.searchParams.get("session_id") ?? "";
const checkoutError = Astro.url.searchParams.get("error");
const canBook = offer.availability === "available";
const signInHref = `/sign-in?next=${encodeURIComponent(`/offers/${offer.slug}`)}`;
const iconFor = (type: string): ProductIconName => (["course", "online_course", "in_person_course", "video_course", "audio_book", "ebook", "quiz", "test", "mock_exam", "reading"] as string[]).includes(type) ? type as ProductIconName : "course";
---

<BaseLayout title={`${offer.title} — PencilScope`} description={offer.description}>
  <main class="shell offer-detail-page">
    <nav class="creator-breadcrumb" aria-label="Breadcrumb"><a href="/offers">Explore learning</a><span aria-hidden="true">›</span><strong>{offer.title}</strong></nav>
    <section class="offer-detail-hero">
      <div class="offer-detail-copy"><span class="eyebrow">{offer.offerKind === "bundle" ? "Bundle" : offer.offerKind === "course" ? "Course" : "Single resource"}</span><h1>{offer.title}</h1><p>{offer.description}</p><div class="offer-includes">{offer.formats.map((format) => <span>{format.replaceAll("_", " ")}</span>)}</div><p class="offer-byline">Created by <strong>{offer.creatorName}</strong></p></div>
      <aside class="panel offer-booking-card"><span class:list={["offer-availability", `availability-${offer.availability}`]}>{offerAvailabilityLabel[offer.availability]}</span><strong class="offer-detail-price">{offerPrice(offer)}</strong><p>{offer.itemCount} included product{offer.itemCount === 1 ? "" : "s"}{offer.startsAt ? ` · starts ${new Date(offer.startsAt).toLocaleDateString("en-SG")}` : " · start anytime"}</p>{checkoutError && <p class="form-error">{checkoutError}</p>}{checkoutSuccess && <div class="checkout-confirmation checkout-pending" data-checkout-session={checkoutSessionId}><span class="checkout-spinner" aria-hidden="true"></span><div><strong>Payment received</strong><p data-checkout-message>Adding every included product to My Learning…</p></div></div>}{!checkoutSuccess && canBook && signedIn && <form class="checkout-form" action="/api/checkout" method="post">{offer.slug.startsWith("product-") ? <input type="hidden" name="productOfferId" value={offer.id} /> : <><input type="hidden" name="courseId" value={offer.courseId ?? ""} /><input type="hidden" name="offeringId" value={offer.id} /><input type="hidden" name="studentId" value={String(userId)} /></>}<input type="hidden" name="returnTo" value={`/offers/${offer.slug}`} /><button class="button button-full" type="submit">Continue to secure checkout</button></form>}{!checkoutSuccess && canBook && !signedIn && <a class="button button-full" href={signInHref}>Sign in to enrol</a>}{!checkoutSuccess && !canBook && <button class="button button-full" disabled>{offerAvailabilityLabel[offer.availability]}</button>}<small>Secure checkout powered by Stripe</small></aside>
    </section>
    <section class="offer-detail-includes"><div class="landing-section-heading"><div><span class="eyebrow">What’s included</span><h2>Everything you will receive.</h2></div><p>One enrolment unlocks every item listed below.</p></div><div class="offer-item-list">{items.map((item, index) => <article><ProductIcon name={iconFor(item.productType)} /><div><span class="eyebrow">{index + 1} · {item.productType.replaceAll("_", " ")}</span><h3>{item.title}</h3><p>{item.description}</p>{item.offeringTitle && <small>{item.offeringTitle}{item.startsAt ? ` · ${new Date(item.startsAt).toLocaleDateString("en-SG")}` : ""}</small>}</div></article>)}</div></section>
  </main>
</BaseLayout>

<script>
  const confirmation = document.querySelector<HTMLElement>("[data-checkout-session]");
  const checkoutSession = confirmation?.dataset.checkoutSession;
  if (confirmation && checkoutSession) {
    const message = confirmation.querySelector<HTMLElement>("[data-checkout-message]");
    let attempts = 0;
    const check = async () => {
      attempts += 1;
      try {
        const response = await fetch(`/api/checkout/status?sessionId=${encodeURIComponent(checkoutSession)}`, { headers: { accept: "application/json" } });
        const result = await response.json() as { ready?: boolean };
        if (response.ok && result.ready) { confirmation.classList.remove("checkout-pending"); confirmation.classList.add("checkout-confirmed"); if (message) message.textContent = "Your products are ready in My Learning."; setTimeout(() => { window.location.href = "/dashboard?workspace=learning&section=learning"; }, 900); return; }
      } catch {}
      if (attempts < 15) setTimeout(check, 1000);
      else if (message) message.textContent = "Your payment is confirmed. My Learning will update shortly.";
    };
    check();
  }
</script>
