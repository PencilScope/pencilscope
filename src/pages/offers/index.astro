---
import OfferCard from "@/components/OfferCard.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { listPublishedOffers } from "@/lib/api-client";
import { localeFromCookies, translator } from "@/lib/i18n";
import { learningLanguages } from "@/lib/languages";

const locale = localeFromCookies(Astro.cookies);
const t = translator(locale);
const query = Astro.url.searchParams.get("q")?.trim().slice(0, 100) ?? "";
const kind = Astro.url.searchParams.get("kind")?.trim() ?? "";
const type = Astro.url.searchParams.get("type")?.trim() ?? "";
const topic = Astro.url.searchParams.get("topic")?.trim() ?? "";
const delivery = Astro.url.searchParams.get("delivery")?.trim() ?? "";
const availability = Astro.url.searchParams.get("availability")?.trim() ?? "";
const language = Astro.url.searchParams.get("language")?.trim() ?? "";
const sort = Astro.url.searchParams.get("sort")?.trim() ?? "relevant";
const filters = { q: query, kind, type, topic, delivery, availability, language, sort };
const [offers, catalogue] = await Promise.all([listPublishedOffers(filters), listPublishedOffers()]);
const topics = [...new Set(catalogue.flatMap((offer) => offer.topics))].sort((left, right) => left.localeCompare(right));
const link = (changes: Partial<typeof filters> = {}) => {
  const next = { ...filters, ...changes };
  const params = new URLSearchParams();
  Object.entries(next).forEach(([key, value]) => { if (value && !(key === "sort" && value === "relevant")) params.set(key, value); });
  return `/offers${params.size ? `?${params}` : ""}`;
};
const activeFilterCount = [kind, type, topic, delivery, availability, language].filter(Boolean).length;
---

<BaseLayout title="Explore learning — PencilScope" description="Discover expert-led courses, focused learning resources and curated bundles.">
  <section class="catalogue-hero"><div class="shell catalogue-hero-inner">
    <div><span class="eyebrow">{t("exploreLearning")}</span><h1>{t("catalogueTitle")}</h1><p>{t("catalogueCopy")}</p></div>
    <form class="catalogue-search" action="/offers" method="get" role="search"><label class="sr-only" for="offer-search">{t("searchLearning")}</label><span aria-hidden="true">⌕</span><input id="offer-search" name="q" type="search" value={query} placeholder={t("catalogueSearchPlaceholder")} />{kind && <input type="hidden" name="kind" value={kind} />}{type && <input type="hidden" name="type" value={type} />}{topic && <input type="hidden" name="topic" value={topic} />}{delivery && <input type="hidden" name="delivery" value={delivery} />}{availability && <input type="hidden" name="availability" value={availability} />}{language && <input type="hidden" name="language" value={language} />}{sort !== "relevant" && <input type="hidden" name="sort" value={sort} />}<button class="button button-small" type="submit">{t("search")}</button></form>
  </div></section>
  <section class="shell catalogue-section compact-catalogue" id="offers">
    <div class="catalogue-filter-groups">
      <div><strong>{t("learningType")}</strong><nav class="catalogue-filters" aria-label="Learning type"><a class:list={["filter", { active: !kind }]} href={link({ kind: "" })}>{t("allLearning")}</a><a class:list={["filter", { active: kind === "course" }]} href={link({ kind: "course" })}>{t("courses")}</a><a class:list={["filter", { active: kind === "independent" }]} href={link({ kind: "independent" })}>{t("singleResources")}</a><a class:list={["filter", { active: kind === "bundle" }]} href={link({ kind: "bundle" })}>{t("bundles")}</a></nav></div>
      <div><strong>{t("format")}</strong><nav class="catalogue-filters" aria-label="Content format"><a class:list={["filter", { active: !type }]} href={link({ type: "" })}>{t("allFormats")}</a><a class:list={["filter", { active: type === "ebook" }]} href={link({ type: "ebook" })}>Ebooks</a><a class:list={["filter", { active: type === "reading" }]} href={link({ type: "reading" })}>Readings</a><a class:list={["filter", { active: type === "video" }]} href={link({ type: "video" })}>Video</a><a class:list={["filter", { active: type === "audio_book" || type === "audio" }]} href={link({ type: "audio" })}>Audio</a><a class:list={["filter", { active: ["quiz", "test", "mock_exam"].includes(type) }]} href={link({ type: "assessment" })}>{t("assessments")}</a></nav></div>
    </div>
    <form class="catalogue-refine" action="/offers" method="get"><input type="hidden" name="q" value={query} /><input type="hidden" name="kind" value={kind} /><input type="hidden" name="type" value={type} /><label>{t("topic")}<select name="topic"><option value="">{t("allTopics")}</option>{topics.map((value) => <option value={value} selected={topic === value}>{value}</option>)}</select></label><label>{t("languageFilter")}<select name="language"><option value="">{t("anyLanguage")}</option>{learningLanguages.map((item) => <option value={item.code} selected={language === item.code}>{item.label}</option>)}</select></label><label>{t("delivery")}<select name="delivery"><option value="">{t("anyDelivery")}</option><option value="self_paced" selected={delivery === "self_paced"}>{t("selfPaced")}</option><option value="live_online" selected={delivery === "live_online"}>{t("liveOnline")}</option><option value="in_person" selected={delivery === "in_person"}>{t("inPerson")}</option><option value="hybrid" selected={delivery === "hybrid"}>{t("hybrid")}</option></select></label><label>{t("availability")}<select name="availability"><option value="">{t("anyAvailability")}</option><option value="available" selected={availability === "available"}>{t("availableNow")}</option><option value="opens_soon" selected={availability === "opens_soon"}>{t("openingSoon")}</option></select></label><label>{t("sortBy")}<select name="sort"><option value="relevant" selected={sort === "relevant"}>{t("mostRelevant")}</option><option value="newest" selected={sort === "newest"}>{t("newest")}</option><option value="starting_soon" selected={sort === "starting_soon"}>{t("startingSoon")}</option><option value="price_low" selected={sort === "price_low"}>{t("priceLow")}</option><option value="price_high" selected={sort === "price_high"}>{t("priceHigh")}</option></select></label><button class="button button-small button-secondary" type="submit">{t("applyFilters")}</button></form>
    <div class="catalogue-summary"><p><strong>{offers.length}</strong> {t(offers.length === 1 ? "result" : "results")}{query && <> · <strong>“{query}”</strong></>}</p>{(query || activeFilterCount || sort !== "relevant") && <a class="text-link" href="/offers">{t("clearFilters")}</a>}</div>
    {offers.length ? <div class="offer-grid">{offers.map((offer) => <OfferCard offer={offer} />)}</div> : <div class="panel catalogue-empty"><span aria-hidden="true">⌕</span><h2>{t("noFilterMatches")}</h2><p>{t("broadenFilters")}</p><a class="button button-secondary" href="/offers">{t("showAll")}</a></div>}
  </section>
</BaseLayout>
