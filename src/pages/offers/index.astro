---
import OfferCard from "@/components/OfferCard.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { listPublishedOffers } from "@/lib/api-client";

const query = Astro.url.searchParams.get("q")?.trim().slice(0, 100) ?? "";
const kind = Astro.url.searchParams.get("kind")?.trim() ?? "";
const type = Astro.url.searchParams.get("type")?.trim() ?? "";
const topic = Astro.url.searchParams.get("topic")?.trim() ?? "";
const delivery = Astro.url.searchParams.get("delivery")?.trim() ?? "";
const availability = Astro.url.searchParams.get("availability")?.trim() ?? "";
const sort = Astro.url.searchParams.get("sort")?.trim() ?? "relevant";
const filters = { q: query, kind, type, topic, delivery, availability, sort };
const [offers, catalogue] = await Promise.all([listPublishedOffers(filters), listPublishedOffers()]);
const topics = [...new Set(catalogue.flatMap((offer) => offer.topics))].sort((left, right) => left.localeCompare(right));
const link = (changes: Partial<typeof filters> = {}) => {
  const next = { ...filters, ...changes };
  const params = new URLSearchParams();
  Object.entries(next).forEach(([key, value]) => { if (value && !(key === "sort" && value === "relevant")) params.set(key, value); });
  return `/offers${params.size ? `?${params}` : ""}`;
};
const activeFilterCount = [kind, type, topic, delivery, availability].filter(Boolean).length;
---

<BaseLayout title="Explore learning — PencilScope" description="Discover expert-led courses, focused learning resources and curated bundles.">
  <section class="catalogue-hero"><div class="shell catalogue-hero-inner">
    <div><span class="eyebrow">Explore learning</span><h1>Find learning that fits your goal.</h1><p>Browse expert-led courses, focused resources and curated bundles—with price and availability shown upfront.</p></div>
    <form class="catalogue-search" action="/offers" method="get" role="search"><label class="sr-only" for="offer-search">Search learning</label><span aria-hidden="true">⌕</span><input id="offer-search" name="q" type="search" value={query} placeholder="Search by topic, skill, format or expert…" />{kind && <input type="hidden" name="kind" value={kind} />}{type && <input type="hidden" name="type" value={type} />}{topic && <input type="hidden" name="topic" value={topic} />}{delivery && <input type="hidden" name="delivery" value={delivery} />}{availability && <input type="hidden" name="availability" value={availability} />}{sort !== "relevant" && <input type="hidden" name="sort" value={sort} />}<button class="button button-small" type="submit">Search</button></form>
  </div></section>
  <section class="shell catalogue-section compact-catalogue" id="offers">
    <div class="catalogue-filter-groups">
      <div><strong>Learning type</strong><nav class="catalogue-filters" aria-label="Learning type"><a class:list={["filter", { active: !kind }]} href={link({ kind: "" })}>All learning</a><a class:list={["filter", { active: kind === "course" }]} href={link({ kind: "course" })}>Courses</a><a class:list={["filter", { active: kind === "independent" }]} href={link({ kind: "independent" })}>Single resources</a><a class:list={["filter", { active: kind === "bundle" }]} href={link({ kind: "bundle" })}>Bundles</a></nav></div>
      <div><strong>Format</strong><nav class="catalogue-filters" aria-label="Content format"><a class:list={["filter", { active: !type }]} href={link({ type: "" })}>All formats</a><a class:list={["filter", { active: type === "ebook" }]} href={link({ type: "ebook" })}>Ebooks</a><a class:list={["filter", { active: type === "reading" }]} href={link({ type: "reading" })}>Readings</a><a class:list={["filter", { active: type === "video" }]} href={link({ type: "video" })}>Video</a><a class:list={["filter", { active: type === "audio_book" || type === "audio" }]} href={link({ type: "audio" })}>Audio</a><a class:list={["filter", { active: ["quiz", "test", "mock_exam"].includes(type) }]} href={link({ type: "assessment" })}>Assessments</a></nav></div>
    </div>
    <form class="catalogue-refine" action="/offers" method="get"><input type="hidden" name="q" value={query} /><input type="hidden" name="kind" value={kind} /><input type="hidden" name="type" value={type} /><label>Topic<select name="topic"><option value="">All topics</option>{topics.map((value) => <option value={value} selected={topic === value}>{value}</option>)}</select></label><label>Delivery<select name="delivery"><option value="">Any delivery</option><option value="self_paced" selected={delivery === "self_paced"}>Self-paced</option><option value="live_online" selected={delivery === "live_online"}>Live online</option><option value="in_person" selected={delivery === "in_person"}>In person</option><option value="hybrid" selected={delivery === "hybrid"}>Hybrid</option></select></label><label>Availability<select name="availability"><option value="">Any availability</option><option value="available" selected={availability === "available"}>Available now</option><option value="opens_soon" selected={availability === "opens_soon"}>Opening soon</option></select></label><label>Sort by<select name="sort"><option value="relevant" selected={sort === "relevant"}>Most relevant</option><option value="newest" selected={sort === "newest"}>Newest</option><option value="starting_soon" selected={sort === "starting_soon"}>Starting soon</option><option value="price_low" selected={sort === "price_low"}>Price: low to high</option><option value="price_high" selected={sort === "price_high"}>Price: high to low</option></select></label><button class="button button-small button-secondary" type="submit">Apply filters</button></form>
    <div class="catalogue-summary"><p><strong>{offers.length}</strong> learning {offers.length === 1 ? "result" : "results"}{query && <> for <strong>“{query}”</strong></>}</p>{(query || activeFilterCount || sort !== "relevant") && <a class="text-link" href="/offers">Clear all filters</a>}</div>
    {offers.length ? <div class="offer-grid">{offers.map((offer) => <OfferCard offer={offer} />)}</div> : <div class="panel catalogue-empty"><span aria-hidden="true">⌕</span><h2>No learning matches these filters</h2><p>Try a broader topic, another format, or clear the filters.</p><a class="button button-secondary" href="/offers">Show all learning</a></div>}
  </section>
</BaseLayout>
