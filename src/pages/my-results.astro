---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { requestApi } from "@/lib/api-client";

const userId = await Astro.session?.get("userId");
if (typeof userId !== "string") return Astro.redirect("/sign-in?next=/my-results");
const response = await requestApi("/api/my-results", { userId });
if (!response.ok) return Astro.redirect("/dashboard");
const data = await response.json<{
  courseAttempts: Array<{ id: string; title: string; assessment_type: string; course_title: string; status: string; started_at: string; submitted_at: string | null; score: number | null; passed: number | null }>;
  standaloneAttempts: Array<{ id: string; title: string; product_type: string; score: number; passed: number; submitted_at: string }>;
}>();
---
<BaseLayout title="My results — PencilScope">
  <section class="dashboard-hero"><div class="shell"><a class="back-link" href="/dashboard?workspace=learning&section=results">← Results</a><span class="eyebrow">Learning progress</span><h1>My assessment results</h1><p>See your quiz, test and mock-exam attempts across all learning products.</p></div></section>
  <section class="shell operations-layout">
    <article class="panel"><span class="eyebrow">Course assessments</span><h2>Course attempt history</h2>{data.courseAttempts.length ? <div class="result-history">{data.courseAttempts.map((attempt) => <section><div><strong>{attempt.title}</strong><small>{attempt.course_title} · {attempt.assessment_type.replace("_", " ")}</small></div><span class:list={["result-score", { passed: attempt.passed }]}>{attempt.score === null ? attempt.status : `${attempt.score}%`}</span><small>{new Date(attempt.submitted_at ?? attempt.started_at).toLocaleString("en-SG")}</small></section>)}</div> : <p class="form-message">No course assessment attempts yet.</p>}</article>
    <article class="panel"><span class="eyebrow">Learning assessments</span><h2>Product attempt history</h2>{data.standaloneAttempts.length ? <div class="result-history">{data.standaloneAttempts.map((attempt) => <section><div><strong>{attempt.title}</strong><small>{attempt.product_type.replace("_", " ")}</small></div><span class:list={["result-score", { passed: attempt.passed }]}>{attempt.score}%</span><small>{new Date(attempt.submitted_at).toLocaleString("en-SG")}</small></section>)}</div> : <p class="form-message">No learning product assessment attempts yet.</p>}</article>
  </section>
</BaseLayout>
