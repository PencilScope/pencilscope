{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "pencilscope-system-admin",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-04",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  "vars": { "ENVIRONMENT": "development" },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "pencilscope-db-local",
    "database_id": "8485d16d-3231-4385-9bbf-c51b4d699522",
    "migrations_dir": "../../migrations"
  }],
  "services": [{ "binding": "CORE_API", "service": "pencilscope-api" }],
  "r2_buckets": [{ "binding": "CONTACT_ENQUIRIES", "bucket_name": "pencilscope-contact-enquiries" }],
  "env": {
    "uat": {
      "workers_dev": true,
      "preview_urls": false,
      "vars": { "ENVIRONMENT": "uat" },
      "d1_databases": [{
        "binding": "DB", "database_name": "pencilscope-db-uat",
        "database_id": "75cb8b3f-33f9-4842-ad63-9d4f9ed32a4b", "migrations_dir": "../../migrations"
      }],
      "services": [{ "binding": "CORE_API", "service": "pencilscope-api-uat" }],
      "r2_buckets": [{ "binding": "CONTACT_ENQUIRIES", "bucket_name": "pencilscope-contact-enquiries-uat" }]
    },
    "production": {
      "workers_dev": true,
      "preview_urls": false,
      "vars": { "ENVIRONMENT": "production" },
      "d1_databases": [{
        "binding": "DB", "database_name": "pencilscope-db-production",
        "database_id": "5a759f23-f07d-455a-b3f6-a5e458eac229", "migrations_dir": "../../migrations"
      }],
      "services": [{ "binding": "CORE_API", "service": "pencilscope-api-production" }],
      "r2_buckets": [{ "binding": "CONTACT_ENQUIRIES", "bucket_name": "pencilscope-contact-enquiries-production" }]
    }
  }
}
