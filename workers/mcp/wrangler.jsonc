{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "pencilscope-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-04",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  "vars": {
    "ENVIRONMENT": "development",
    "AUTHORIZATION_SERVER": "http://localhost:4321",
    "MCP_ORIGIN": "http://localhost:8790"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "pencilscope-db-local",
    "database_id": "8485d16d-3231-4385-9bbf-c51b4d699522",
    "migrations_dir": "../../migrations"
  }],
  "services": [{ "binding": "API", "service": "pencilscope-api" }],
  "env": {
    "uat": {
      "workers_dev": true,
      "preview_urls": false,
      "vars": {
        "ENVIRONMENT": "uat",
        "AUTHORIZATION_SERVER": "https://pencilscope-uat.rdproducts-adm1.workers.dev",
        "MCP_ORIGIN": "https://pencilscope-mcp-uat.rdproducts-adm1.workers.dev"
      },
      "d1_databases": [{
        "binding": "DB",
        "database_name": "pencilscope-db-uat",
        "database_id": "75cb8b3f-33f9-4842-ad63-9d4f9ed32a4b",
        "migrations_dir": "../../migrations"
      }],
      "services": [{ "binding": "API", "service": "pencilscope-api-uat" }]
    },
    "production": {
      "workers_dev": true,
      "preview_urls": false,
      "vars": {
        "ENVIRONMENT": "production",
        "AUTHORIZATION_SERVER": "https://pencilscope.com",
        "MCP_ORIGIN": "https://pencilscope-mcp-production.rdproducts-adm1.workers.dev"
      },
      "d1_databases": [{
        "binding": "DB",
        "database_name": "pencilscope-db-production",
        "database_id": "5a759f23-f07d-455a-b3f6-a5e458eac229",
        "migrations_dir": "../../migrations"
      }],
      "services": [{ "binding": "API", "service": "pencilscope-api-production" }]
    }
  }
}
