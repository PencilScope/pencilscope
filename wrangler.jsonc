{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "pencilscope",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"compatibility_date": "2026-10-04",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist"
	},
	"observability": {
		"enabled": true
	},
	"vars": {
		"APP_URL": "http://localhost:4321",
		"ENVIRONMENT": "development"
	},
	"services": [
		{
			"binding": "API",
			"service": "pencilscope-api"
		}
	],
	"env": {
		"uat": {
			"vars": {
				"APP_URL": "https://pencilscope-uat.rdproducts-adm1.workers.dev",
				"ENVIRONMENT": "uat"
			},
			"services": [
				{
					"binding": "API",
					"service": "pencilscope-api-uat"
				}
			]
		},
		"production": {
			"vars": {
				"APP_URL": "https://pencilscope-production.rdproducts-adm1.workers.dev",
				"ENVIRONMENT": "production"
			},
			"services": [
				{
					"binding": "API",
					"service": "pencilscope-api-production"
				}
			]
		}
	}
}
