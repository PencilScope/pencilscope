{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "pencilscope",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"compatibility_date": "2026-10-04",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist"
	},
	"observability": {
		"enabled": true
	},
	"vars": {
		"APP_URL": "http://localhost:4321",
		"ENVIRONMENT": "development",
		"FACEBOOK_GRAPH_VERSION": "v26.0",
		"MCP_SERVER_URL": "http://localhost:8790/mcp"
	},
	"services": [
		{
			"binding": "API",
			"service": "pencilscope-api"
		}
	],
	"env": {
		"uat": {
			"vars": {
				"APP_URL": "https://pencilscope-uat.rdproducts-adm1.workers.dev",
				"ENVIRONMENT": "uat",
				"FACEBOOK_GRAPH_VERSION": "v26.0",
				"MCP_SERVER_URL": "https://pencilscope-mcp-uat.rdproducts-adm1.workers.dev/mcp"
			},
			"services": [
				{
					"binding": "API",
					"service": "pencilscope-api-uat"
				}
			]
		},
		"production": {
			"vars": {
				"APP_URL": "https://pencilscope.com",
				"ENVIRONMENT": "production",
				"FACEBOOK_GRAPH_VERSION": "v26.0",
				"MCP_SERVER_URL": "https://pencilscope-mcp-production.rdproducts-adm1.workers.dev/mcp"
			},
			"services": [
				{
					"binding": "API",
					"service": "pencilscope-api-production"
				}
			]
		}
	}
}
