{
  "name": "pencilscope",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.4",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:uat": "node scripts/cloudflare-environment.mjs uat build",
    "build:production": "node scripts/cloudflare-environment.mjs production build",
    "check": "astro check",
    "preview": "astro preview",
    "deploy": "pnpm build && wrangler deploy",
    "deploy:uat": "node scripts/cloudflare-environment.mjs uat deploy",
    "deploy:production": "node scripts/cloudflare-environment.mjs production deploy",
    "cf-types": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:migrate:uat": "wrangler d1 migrations apply DB --remote --env uat",
    "db:migrate:production": "wrangler d1 migrations apply DB --remote --env production"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.3",
    "astro": "^7.3.5",
    "resend": "^6.32.0",
    "stripe": "^23.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^5.20261004.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.147.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ],
    "overrides": {
      "yargs-parser": "21.1.1"
    }
  }
}
